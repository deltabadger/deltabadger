#!/usr/bin/env bash
# The desktop app in development: a debug engine as its sidecar (script/rust/desktop_engine.sh --debug, run by
# tauri.conf.json's beforeDevCommand), the app under its development identifier, so it never meets an installed app's
# single instance, with its data in storage/desktop-dev/.
set -euo pipefail
cd "$(dirname "$0")/.."
bun install --frozen-lockfile
exec bunx tauri dev --config '{"identifier":"com.deltabadger.app.dev"}' "$@"
