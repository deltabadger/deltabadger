#!/usr/bin/env bash
set -euo pipefail

bundle update --all
bin/rails test

if git diff --quiet && git diff --cached --quiet; then
  echo "No changes after bundle update — nothing to commit."
  exit 0
fi

branch="deps-$(date +%Y%m%d)"
git switch -c "$branch"
git commit -am "dependency update"
git push -u origin "$branch"
gh pr create --fill

echo "Push main:nightly after the PR is merged."
