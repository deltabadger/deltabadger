#!/usr/bin/env bash
# The Rust app for frontend work: Sass and the JS bundle rebuild on save, and a debug `serve` reads them from disk
# (DELTABADGER_DEV_ASSETS, src/web/assets.rs), so a style or script change shows on the next browser reload with no
# cargo build. A Rust, template or locale change rebuilds the binary and restarts `serve` (a failed build keeps the last one).
#   bin/rust-dev
# PORT (default 3001), STORAGE_DIR (default tmp/rust-dev: the install survives restarts; delete it for a fresh one),
# CARGO (default cargo) and CARGO_TARGET_DIR (default rust/target) as cargo itself reads them.
# Every install, on every port and in every worktree, signs in as admin@test.com with the one password in
# DEV_PASSWORD_FILE (default ~/.config/deltabadger/dev-password): set on each start, so a password manager's one entry
# for 127.0.0.1 keeps working whichever agent started which port. Never change it from an agent.
set -euo pipefail
cd "$(dirname "$0")/.."
root=$PWD
cargo=${CARGO:-cargo}
port=${PORT:-3001}
storage=${STORAGE_DIR:-$root/tmp/rust-dev}

# The first build of both files; the debug binary embeds them too, so it must find them.
script/rust/build_assets.sh
(cd rust && "$cargo" build --bin deltabadger)
target_dir=${CARGO_TARGET_DIR:-target}
case "$target_dir" in /*) ;; *) target_dir="rust/$target_dir" ;; esac

pids=()
server=
trap 'kill "${pids[@]}" $server 2>/dev/null; wait' EXIT INT TERM
bun x --no-install sass --watch --no-source-map \
  --load-path rust/web/stylesheets --load-path node_modules --load-path rust/web/fonts \
  rust/web/stylesheets/application.scss:rust/web/builds/application.css &
pids+=($!)
bun run build:watch &
pids+=($!)

mkdir -p "$storage"
# The binary served is this install's own copy, taken right after this worktree's build: a target shared with another
# worktree (CARGO_TARGET_DIR) is overwritten by that one's builds, and its server would end up serving this one's code.
keep() { cp "$target_dir/debug/deltabadger" "$storage/deltabadger.new" && mv "$storage/deltabadger.new" "$storage/deltabadger"; }
keep
# One secret per dev install, kept beside it: the install's encrypted columns need the same one on every start.
[ -s "$storage/.dev-secret" ] || openssl rand -hex 64 > "$storage/.dev-secret"
serve() {
  DELTABADGER_DEV_ASSETS="$root/rust/web/builds" \
    STORAGE_DIR="$storage" DATABASE_PATH="$storage/production.sqlite3" QUEUE_DATABASE_PATH="$storage/production_queue.sqlite3" \
    SECRET_KEY_BASE="$(cat "$storage/.dev-secret")" PORT="$port" APP_ROOT_URL="http://127.0.0.1:$port" \
    "$storage/deltabadger" serve &
  server=$!
}
echo "rust-dev: http://127.0.0.1:$port (install in $storage)"
dev_password=${DEV_PASSWORD_FILE:-$HOME/.config/deltabadger/dev-password}
if [ -s "$dev_password" ] && [ -s "$storage/production.sqlite3" ]; then
  # A fresh install has no account yet: sign up as admin@test.com with that password, and the next start keeps it.
  STORAGE_DIR="$storage" DATABASE_PATH="$storage/production.sqlite3" QUEUE_DATABASE_PATH="$storage/production_queue.sqlite3" \
    SECRET_KEY_BASE="$(cat "$storage/.dev-secret")" "$storage/deltabadger" reset-password admin@test.com --stdin < "$dev_password" \
    || echo "rust-dev: admin@test.com keeps its password (above: why)"
fi
serve
# ponytail: a 1 s poll (no watcher installed here); watchexec if this ever feels slow.
stamp=$(mktemp)
while sleep 1; do
  [ -n "$(find rust/src rust/templates rust/locales rust/Cargo.toml -newer "$stamp" -type f -print -quit)" ] || continue
  touch "$stamp" # before the build: a save during it starts another
  echo "rust-dev: rebuilding"
  # build.rs again: the target may be shared with another worktree (its embedded files are this one's)
  if touch rust/build.rs && (cd rust && "$cargo" build --bin deltabadger) && keep; then
    kill "$server"; wait "$server" || true
    serve
    echo "rust-dev: restarted"
  else
    echo "rust-dev: build failed; still serving the last build"
  fi
done
