{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deltabadger",
  "version": "2.41.1",
  "identifier": "com.deltabadger.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "./scripts/bundle_desktop.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/deltabadger/deltabadger/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../_bundle/app": "app",
      "../_bundle/ruby": "ruby",
      "icons/tray-icon.png": "icons/tray-icon.png"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
