{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Deltabadger",
  "mainBinaryName": "Deltabadger",
  "version": "3.0.0-beta.3",
  "identifier": "com.deltabadger.app",
  "build": {
    "frontendDist": "ui",
    "beforeDevCommand": {
      "script": "bash script/rust/desktop_engine.sh --debug",
      "wait": true
    },
    "beforeBuildCommand": "bash script/rust/desktop_engine.sh"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/deltabadger/deltabadger/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY",
      "requireSignedVersion": true
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.3",
      "infoPlist": "Info.plist"
    },
    "resources": {
      "../db/seed_data/catalogue.json.gz": "db/seed_data/catalogue.json.gz",
      "icons/tray-icon.png": "icons/tray-icon.png"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "installerHooks": "windows/hooks.nsh"
      }
    },
    "externalBin": [
      "binaries/deltabadger-engine"
    ]
  }
}
