# Git
.git
.gitignore
.gitattributes

# CI/CD
.circleci
.github

# Documentation
*.md
!README.md
LICENSE

# Development files
.env
.env.*
!.env.example

# IDE and editor
.idea
.vscode
*.swp
*.swo
*~
.DS_Store

# Test files
# Rails' frozen answers (PLAN-B11 B11-1): the Rust tests' expected values, never part of an image.
rust/tests/recorded/
coverage/

# Logs
log/*
!log/.keep
*.log

# Temp files
tmp/*
!tmp/.keep
!tmp/pids
!tmp/cache
!tmp/sockets

# Node modules (copied separately in Dockerfile)
node_modules/

# Build artifacts (exclude compiled assets but keep fonts)
rust/web/public/assets/*
!rust/web/public/assets/*.ttf
!rust/web/public/assets/*.woff
!rust/web/public/assets/*.woff2
rust/web/public/packs
.sass-cache

# Rust build output (rust/, src-tauri/)
**/target

# Storage (mounted as volume)
storage/*
!storage/.keep

# Database files
*.sqlite3
*.sqlite3-*

# Docker files (not needed in image)
Dockerfile*
docker-compose*.yml
.dockerignore
umbrel-app.yml

# Misc
Thumbs.db

# The API manual is compiled into the Rust build (rust/src/web/settings/api.rs MANUAL).
!manual/api.md
