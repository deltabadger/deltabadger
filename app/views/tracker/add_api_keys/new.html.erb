<%= render 'layouts/modal/full_page', close_url: tracker_path do %>
  <div class="bot-creation-layout">
    <%= render 'bots/new_step_progress_bar', current_step: :connect, steps: { exchange: 50, connect: 100 } %>
    <div class="conversational conversational--bot-setup"
         data-controller="conversational-sentence"
         data-action="click->conversational-sentence#activate input->conversational-sentence#updateFilled">
      <%= t('tracker.import_from') %>
      <%= form_with url: new_tracker_pick_exchange_path, method: :get, class: "conversational__link filled",
                    data: { turbo_frame: "modal_content", wizard_dir: "back" } do %>
        <input value="<%= @exchange.name %>" readonly tabindex="-1">
      <% end %>
    </div>
    <%= render partial: 'shared/api_key_form', locals: {
      exchange: @exchange,
      api_key: @api_key,
      path: tracker_add_api_key_path,
      form_data: { controller: 'form--label-animations form--html5-validations', turbo_frame: 'modal_content' }
    } %>
  </div>
<% end %>
