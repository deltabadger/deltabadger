<%# Locals: exchanges (names), replace (Exchanges whose key is missing a permission). The contents of
    #sync-warnings only — every stream targets it with `update`. The wrapper is data-turbo-permanent,
    and Turbo swaps a streamed element carrying that same permanent id back for a clone of the old
    one, so a `replace` would never change what the reader sees. %>
<% if exchanges.any? %>
  <div class="flash__message salert salert--danger" data-controller="removals" role="alert">
    <button class="modal__close" data-action="removals#remove">
      <%= render 'svg/24x24_close' %>
    </button>
    <%# join, not to_sentence: rails-i18n is absent, so to_sentence glues the list with an English "and" in all 15 locales. %>
    <%= t('tracker.sync_failed_for', exchanges: exchanges.join(', ')) %>
    <% replace.each do |exchange| %>
      <%= render 'tracker/replace_key_button', exchange_name: exchange.name, exchange_id: exchange.id %>
    <% end %>
  </div>
<% end %>
