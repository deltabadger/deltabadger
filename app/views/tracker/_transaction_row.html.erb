<% hide_money = current_user.hide_balances? %>
<%# The row is rendered both by the page and on its own from a turbo stream, where no controller has
    set up the page's instance variables. `User#denomination` memoises, so this costs one object. %>
<% denomination = current_user.denomination %>
<% asset = tracker_row_asset(at.base_currency) %>
<%# What the row was worth, and whose figure it is. Our own price is the PLACEHOLDER: it is what the
    figures are built on, shown rather than hidden, and a typed value replaces it. Clearing the box
    hands the row back to us. Price is DERIVED from that same worth, so the two money columns are one
    figure read two ways instead of two calculations that can disagree — and both are written in the
    reader's own currency, which the header names once. %>
<% value, source = tracker_row_value(at, denomination) %>
<% shown = value&.round(2) %>
<tr id="<%= dom_id(at) %>" class="tracker-row" data-order-filter-target="row" data-order-type="<%= tracker_row_types(at) %>">
  <td class="text-left tracker-row__when">
    <%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%Y/%m/%d') %>
    <small><%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%H:%M') %></small>
  </td>
  <td class="tracker-exchange-icon"><%= render "svg/exchange-#{at.exchange.name_id}", title: at.exchange.name %></td>
  <td class="text-left">
    <% if at.linked? %>
      <span class="<%= pill_class(:transfer) %>"><%= t('tracker.transfer_badge') %></span>
    <% else %>
      <span class="<%= pill_class(at.entry_type) %>"><%= t("tracker.types.#{at.entry_type}") %></span>
    <% end %>
    <%# Linking is a correction, not a routine action: it belongs on the row it corrects, on hover,
        rather than as a button in every deposit and withdrawal on the page. %>
    <% if at.withdrawal? || at.deposit? %>
      <%= button_to at.linked? ? t('tracker.transfer_unlink') : t('tracker.transfer_link'),
                    toggle_transfer_tracker_transaction_path(at),
                    method: :patch, form_class: 'tracker-row__action' %>
    <% end %>
  </td>
  <td class="text-left"><span class="tracker-row__asset"><% if asset %><%= render 'assets/logo', image_url: asset.image_url, color: asset.color %><% end %><%= at.base_currency %></span></td>
  <% unless hide_money %><td><%= tracker_amount(at.base_amount) %></td><% end %>
  <td><%= tracker_amount(tracker_row_price(at, value)) || '—' %></td>
  <% unless hide_money %>
    <td class="tracker-row__value tracker-row__value--<%= source || 'none' %>">
      <%# A row whose base is money states a fact, not a guess — there is nothing here to fill in. %>
      <% if source == :cash %>
        <%= tracker_amount(shown) %>
      <% else %>
        <%= form_with url: value_tracker_transaction_path(at), method: :patch,
                      data: { controller: 'form--submit' } do %>
          <%= number_field_tag :value, (shown if source == :stated), step: :any, min: 0,
                               placeholder: (source == :stated ? nil : shown&.to_s) || '—',
                               title: t("tracker.value_source.#{source || 'none'}"),
                               class: 'tracker-row__value__input',
                               data: { action: 'change->form--submit#submit' } %>
        <% end %>
      <% end %>
    </td>
    <td class="tracker-row__fee"><%= at.fee_amount.present? ? "#{tracker_amount(at.fee_amount)} #{at.fee_currency}" : '—' %></td>
  <% end %>
  <td>
    <% if at.bot_transaction.present? %>
      <%= link_to "##{at.bot_transaction.bot_id}", bot_path(at.bot_transaction.bot_id) %>
    <% else %>
      —
    <% end %>
  </td>
</tr>
