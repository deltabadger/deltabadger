<% hide_money = current_user.hide_balances? %>
<% asset = tracker_row_asset(at.base_currency) %>
<%# What one unit changed hands at — a market level, not a balance, so it survives hiding. %>
<% price = at.quote_amount.present? && at.base_amount.to_d.positive? ? at.quote_amount.to_d / at.base_amount.to_d : nil %>
<tr id="<%= dom_id(at) %>" class="tracker-row" data-order-filter-target="row" data-order-type="<%= tracker_row_types(at) %>">
  <td class="text-left tracker-row__when">
    <%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%Y/%m/%d') %>
    <small><%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%H:%M') %></small>
  </td>
  <td class="tracker-exchange-icon"><%= render "svg/exchange-#{at.exchange.name_id}", title: at.exchange.name %></td>
  <td class="text-left">
    <% if at.linked? %>
      <span class="tracker-type tracker-type--transfer"><%= t('tracker.transfer_badge') %></span>
    <% else %>
      <span class="tracker-type tracker-type--<%= at.entry_type %>"><%= t("tracker.types.#{at.entry_type}") %></span>
    <% end %>
    <%# Linking is a correction, not a routine action: it belongs on the row it corrects, on hover,
        rather than as a button in every deposit and withdrawal on the page. %>
    <% if at.withdrawal? || at.deposit? %>
      <%= button_to at.linked? ? t('tracker.transfer_unlink') : t('tracker.transfer_link'),
                    toggle_transfer_tracker_transaction_path(at),
                    method: :patch, form_class: 'tracker-row__action' %>
    <% end %>
  </td>
  <td class="text-left"><span class="tracker-row__asset"><% if asset %><%= render 'assets/logo', image_url: asset.image_url, color: asset.color %><% end %><%= at.base_currency %></span></td>
  <% unless hide_money %><td><%= tracker_amount(at.base_amount) %></td><% end %>
  <td><%= price ? tracker_amount(price) : '—' %></td>
  <% unless hide_money %>
    <td><%= at.quote_amount.present? ? "#{tracker_amount(at.quote_amount)} #{at.quote_currency}" : '—' %></td>
    <td class="tracker-row__fee"><%= at.fee_amount.present? ? "#{tracker_amount(at.fee_amount)} #{at.fee_currency}" : '—' %></td>
  <% end %>
  <td>
    <% if at.bot_transaction.present? %>
      <%= link_to "##{at.bot_transaction.bot_id}", bot_path(at.bot_transaction.bot_id) %>
    <% else %>
      —
    <% end %>
  </td>
</tr>
