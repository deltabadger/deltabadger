<% hide_money = current_user.hide_balances? %>
<%# The row is rendered both by the page and on its own from a turbo stream, where no controller has
    set up the page's instance variables. `User#denomination` memoises, so this costs one object. %>
<% denomination = current_user.denomination %>
<% asset = tracker_row_asset(at.base_currency) %>
<%# Amount, Price and Fee are the RECORD. Amount and Fee are the venue's, in its own currency per
    row, and so is Price where the venue booked one. Where it did not, our own price is the
    PLACEHOLDER — shown rather than hidden, and a typed price replaces it; clearing the box hands
    the row back to us. Money's price is its rate for the day. Everything but the venue's own price
    is in the reader's currency, like Value, so Amount × Price = Value reads on every row; the
    record behind the box still holds USD. Value is worked out, never typed. %>
<% price, source = tracker_row_price(at, denomination) %>
<% value = tracker_row_value(at, denomination, price, source)&.round(2) %>
<tr id="<%= dom_id(at) %>" class="tracker-row" data-order-filter-target="row" data-order-type="<%= tracker_row_types(at) %>">
  <td class="text-left tracker-row__when">
    <%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%Y/%m/%d') %>
    <small><%= at.transacted_at.in_time_zone(current_user.time_zone).strftime('%H:%M') %></small>
  </td>
  <td class="tracker-exchange-icon"><%= render "svg/exchange-#{at.exchange.name_id}", title: at.exchange.name %></td>
  <td class="text-left">
    <% if at.linked? %>
      <span class="<%= pill_class(:transfer) %>"><%= t('tracker.transfer_badge') %></span>
    <% else %>
      <span class="<%= pill_class(at.entry_type) %>"><%= t("tracker.types.#{at.entry_type}") %></span>
    <% end %>
    <%# Linking is a correction, not a routine action: it belongs on the row it corrects, on hover,
        rather than as a button in every deposit and withdrawal on the page. %>
    <% if at.withdrawal? || at.deposit? %>
      <%= button_to at.linked? ? t('tracker.transfer_unlink') : t('tracker.transfer_link'),
                    toggle_transfer_tracker_transaction_path(at),
                    method: :patch, form_class: 'tracker-row__action' %>
    <% end %>
  </td>
  <td class="text-left"><span class="tracker-row__asset"><% if asset %><%= render 'assets/logo', image_url: asset.image_url, color: asset.color %><% end %><%= at.base_currency %></span></td>
  <% unless hide_money %><td><%= tracker_amount(at.base_amount) %></td><% end %>
  <td class="tracker-row__price tracker-row__price--<%= source || 'none' %>">
    <% if source == :exchange %>
      <%= price %>
    <% elsif source == :cash %>
      <%= price ? tracker_figure(price, denomination.currency) : '—' %>
    <% else %>
      <%= form_with url: price_tracker_transaction_path(at), method: :patch,
                    data: { controller: 'form--submit' } do %>
        <%= number_field_tag :price, (price if source == :stated), step: :any, min: 0,
                             placeholder: (price.to_s if source == :ours) || '—',
                             title: t("tracker.price_source.#{source || 'none'}"),
                             class: 'tracker-row__price__input',
                             data: { action: 'change->form--submit#submit' } %>
        <small><%= denomination.currency %></small>
        <%# The problem is the empty box, and this is the one place it can be fixed — so this is
            where it is explained, and only here. %>
        <% if source.nil? %>
          <span class="tracker-row__info" role="button" tabindex="0" aria-label="<%= t('tracker.price_source.none') %>"
                data-controller="tooltip" data-tooltip-fixed-value="true"
                data-action="click->tooltip#toggle keydown.enter->tooltip#toggle keydown.space->tooltip#toggle:prevent focus->tooltip#showTooltip blur->tooltip#hideTooltip mouseenter->tooltip#showTooltip mouseleave->tooltip#hideTooltip">
            <%= render partial: 'svg/24x24_info' %>
            <%= tag.div t('tracker.price_source.none'), class: 'tooltip tooltip--hint' %>
          </span>
        <% end %>
      <% end %>
    <% end %>
  </td>
  <% unless hide_money %>
    <td class="tracker-row__value"><%= tracker_amount(value) || '—' %></td>
    <td class="tracker-row__fee"><%= at.fee_amount.present? ? tracker_figure(at.fee_amount, at.fee_currency) : '—' %></td>
  <% end %>
  <td>
    <% if at.bot_transaction.present? %>
      <%= link_to "##{at.bot_transaction.bot_id}", bot_path(at.bot_transaction.bot_id) %>
    <% else %>
      —
    <% end %>
  </td>
</tr>
