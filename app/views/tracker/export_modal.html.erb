<%= render 'layouts/modal/base' do %>
  <div class="modal">
    <%= button_tag type: 'button', class: 'modal__close', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
      <%= render partial: 'svg/24x24_close' %>
    <% end %>
    <div class="modal__header">
      <h1 class="modal__title"><%= t('tracker.export_modal.title') %></h1>
    </div>

    <div data-controller="tracker-export" data-tracker-export-save-url="<%= save_export_settings_tracker_path %>">
      <% transactions = @settings['export_type'] == 'transactions' %>
      <div class="mb-3" data-action="segmented:change->tracker-export#changeType">
        <%= render 'shared/segmented', fluid: true, label: t('tracker.export_modal.title'),
                   options: [{ value: 'tax_report', label: t('tracker.export_modal.tax_report'), active: !transactions },
                             { value: 'transactions', label: t('tracker.export_modal.transactions'), active: transactions }] %>
        <input type="hidden" name="export_type" value="<%= transactions ? 'transactions' : 'tax_report' %>"
               data-tracker-export-target="exportType">
      </div>

      <div data-tracker-export-target="taxOptions" class="<%= 'hidden' if @settings['export_type'] == 'transactions' %>">
        <%= settings_row t('tracker.export_modal.country') do %>
          <select name="country" class="rinput rinput--outline rinput--select" aria-label="<%= t('tracker.export_modal.country') %>"
                  data-tracker-export-target="country" data-action="change->tracker-export#toggle">
            <% @jurisdictions.each do |code, config| %>
              <option value="<%= code %>" <%= 'selected' if @settings['country'] == code %> data-stablecoin-ambiguous="<%= config.fetch(:stablecoin_ambiguous, false) %>"><%= t("tracker.export_modal.countries.#{code}") %></option>
            <% end %>
          </select>
        <% end %>

        <%= settings_row t('tracker.export_modal.year') do %>
          <select name="year" class="rinput rinput--outline rinput--select" aria-label="<%= t('tracker.export_modal.year') %>"
                  data-tracker-export-target="year" data-action="change->tracker-export#changeYear">
            <% crypto_years = ((Date.current.year - 5)..Date.current.year) %>
            <% broker_years = Tax::BrokerReport::SUPPORTED_YEARS %>
            <% (crypto_years.to_a | broker_years.to_a).sort.reverse.each do |y| %>
              <% scopes = [('crypto' if crypto_years.cover?(y)), ('broker' if broker_years.cover?(y))].compact %>
              <option value="<%= y %>" data-scopes="<%= scopes.join(' ') %>" <%= 'selected' if (@settings['year']&.to_i || Date.current.year - 1) == y %>><%= y %></option>
            <% end %>
          </select>
        <% end %>
      </div>

      <%# The crypto/stocks split only exists under German forms (Anlage KAP / KAP-INV), so the row
          renders only with a broker account and shows only while Germany is picked. A stale broker
          scope saved under another country is not restored — that country offers no such choice. %>
      <% if @broker_exchange %>
        <% selected_country = @settings['country'] || @jurisdictions.each_key.first %>
        <% broker_scope = @settings['report_scope'] == 'broker' && selected_country == 'DE' %>
        <div class="flex gap-3 mb-3 <%= 'hidden' if @settings['export_type'] == 'transactions' || selected_country != 'DE' %>"
             data-tracker-export-target="scopeRow">
          <label class="form__radio-group">
            <input type="radio" name="report_scope" value="crypto"
                   data-action="tracker-export#toggle"
                   data-tracker-export-target="scopeRadio"
                   <%= 'checked' unless broker_scope %>>
            <span><%= t('tracker.export_modal.scope_crypto') %></span>
          </label>
          <label class="form__radio-group">
            <input type="radio" name="report_scope" value="broker"
                   data-action="tracker-export#toggle"
                   data-tracker-export-target="scopeRadio"
                   <%= 'checked' if broker_scope %>>
            <span><%= t('tracker.export_modal.scope_broker') %></span>
          </label>
        </div>
      <% end %>

      <%# No rows means nothing to classify — an empty table under "assign a type to every security"
          reads as a bug. The scope choice still shows; the report simply has no securities to refuse. %>
      <%= render 'tracker/fund_classifications', rows: @fund_classification_rows if @fund_classification_rows.any? %>

      <%# Same target as the option row above, so it hides with them: this disclaimer is about the tax
          report and used to be shown over the plain transactions export too. %>
      <p class="text-inactive <%= 'hidden' if @settings['export_type'] == 'transactions' %>"
         data-tracker-export-target="taxOptions"><%= t('tracker.export_modal.tax_disclaimer') %></p>

      <p class="salert salert--danger hidden" data-tracker-export-target="saveError">
        <%= t('tracker.export_modal.classification_save_failed') %>
      </p>

      <div data-tracker-export-target="stablecoinOption" class="hidden">
        <label class="form__checkbox-group">
          <input type="checkbox" name="stablecoin_as_fiat"
                 data-tracker-export-target="stablecoinCheckbox"
                 data-action="change->tracker-export#save"
                 <%= 'checked' if @settings['stablecoin_as_fiat'] %>>
          <span><%= t('tracker.export_modal.stablecoin_as_fiat') %></span>
        </label>
      </div>

      <div data-tracker-export-target="transactionsOptions" class="<%= 'hidden' unless @settings['export_type'] == 'transactions' %>">
        <%= settings_row t('tracker.export_modal.from') do %>
          <input type="date" name="from" class="rinput rinput--outline rinput--text" aria-label="<%= t('tracker.export_modal.from') %>"
                 data-tracker-export-target="dateFrom" value="<%= @settings['export_from'] || @earliest_date %>">
        <% end %>
        <%= settings_row t('tracker.export_modal.to') do %>
          <input type="date" name="to" class="rinput rinput--outline rinput--text" aria-label="<%= t('tracker.export_modal.to') %>"
                 data-tracker-export-target="dateTo" value="<%= @settings['export_to'] || @latest_date %>">
        <% end %>
      </div>

      <div class="modal__footer">
        <a href="#" class="rbutton rbutton--primary"
           data-action="click->tracker-export#download"
           data-tracker-export-target="downloadBtn"
           data-transactions-url="<%= export_tracker_path %>"
           data-tax-report-url="<%= tax_report_tracker_path %>"
           data-fund-classifications-url="<%= fund_classifications_tracker_path %>"
           data-label-generate="<%= t('tracker.export_modal.generate') %>"
           data-label-download="<%= t('tracker.export_modal.download_label') %>">
          <%= @settings['export_type'] == 'transactions' ? t('tracker.export_modal.download_label') : t('tracker.export_modal.generate') %>
        </a>
      </div>
    </div>
  </div>
<% end %>
