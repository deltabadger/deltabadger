<%# Locals: exchange_name, message, reason, capability %>
<%#
  No .html_safe on the t() calls: the _html key suffix already makes the translate helper escape
  the interpolated values, and `message` is an exchange-controlled string. Adding .html_safe back
  would hand a venue the ability to inject markup into this flash.
%>
<div class="flash__message salert salert--danger" data-controller="removals" role="alert">
  <button class="modal__close" data-action="removals#remove">
    <%= render 'svg/24x24_close' %>
  </button>
  <% case reason %>
  <% when :permission %>
    <%= t('tracker.sync_permission_error_html',
          exchange: exchange_name,
          capability: t("tracker.capabilities.#{capability}")) %>
  <% when :invalid %>
    <%= t('tracker.sync_key_error_html', exchange: exchange_name, message: message) %>
  <% when :transient %>
    <%= t('tracker.sync_transient_error_html', exchange: exchange_name) %>
  <% else %>
    <%= t('tracker.sync_generic_error_html', exchange: exchange_name, message: message) %>
  <% end %>
</div>
