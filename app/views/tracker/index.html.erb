<% hide_balances = current_user.hide_balances? %>
<%# A hide-balances toggle in another tab refreshes this one. Subscribed per page rather than in
    the layout: the refresh REPLACES the document, so a settings or setup page listening for it
    would throw away whatever the user had half-typed into an email, password or API-key form.
    Only the pages that state balances have anything to re-render. %>
<%= turbo_stream_from "user_#{current_user.id}", :preferences %>
<%= turbo_stream_from "user_#{current_user.id}", :tax_report %>
<%= turbo_stream_from "user_#{current_user.id}", :sync %>
<%= render 'sync_warning', exchanges: @sync_failures %>
<% if @pending_report %>
  <div data-controller="auto-download" data-auto-download-url-value="<%= download_tax_report_tracker_path(country: @pending_report[:country], year: @pending_report[:year], report_scope: @pending_report[:report_scope]) %>"></div>
<% end %>
<% if @exchanges.empty? && @account_transactions.empty? %>
  <div class="welcome-screen">
    <p><%= t('tracker.welcome.connect_and_track') %></p>
    <div style="margin-top: 2rem; transform: scale(1.5)">
      <%= link_to new_tracker_pick_exchange_path, class: "sbutton sbutton--icon", data: { turbo_frame: "modal" }, aria: { label: t('tracker.connect_exchange') } do %>
        <%= render partial: 'svg/24x24_plus' %>
      <% end %>
    </div>
  </div>
<% else %>
<%# The portfolio total has no percentage to fall back on the way a bot's P/L does — it is the
    balance, and nothing else. The allocation below is what the page shows instead. %>
<% if !hide_balances && @portfolio_total_usd && @portfolio_total_usd.positive? %>
  <section class="dash-intro">
    <h1 class="header header--1">
      <%= @denomination.format(@portfolio_total_usd, precision: 2) %>
    </h1>
  </section>
<% end %>

<div class="two-row-filters">
  <%= render 'exchange_filters' %>
</div>

<%= render 'portfolio_chart' %>

<div class="two-row-filters">
  <div class="two-row-filters__row">
    <div class="filters">
      <%= form_tag tracker_path, method: :get, class: 'tracker-date-range', data: { controller: 'form--submit' } do %>
        <% if params[:exchange_id].present? %>
          <%= hidden_field_tag :exchange_id, params[:exchange_id] %>
        <% end %>
        <input type="date" name="from" value="<%= @date_from %>" class="sinput" data-action="change->form--submit#submit">
        <input type="date" name="to" value="<%= @date_to %>" class="sinput" data-action="change->form--submit#submit">
      <% end %>
    </div>
    <div style="display: flex; gap: 0.5rem">
      <% if @exchanges.any? %>
        <%= link_to export_modal_tracker_path, class: 'sbutton sbutton--sky', data: { turbo_frame: 'modal' } do %>
          <%= t('tracker.get_report') %>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if @account_transactions.any? %>
  <div class="widget widget--table widget--table--tracker">
    <table class="table">
      <thead>
        <tr>
          <th class="tracker-exchange-icon"></th>
          <th class="text-left"><%= t('tracker.columns.date') %></th>
          <th><%= t('tracker.columns.type') %></th>
          <th><%= t('tracker.columns.base') %></th>
          <%# The same three figures the bot log drops: what was traded, what it cost, and what was
              paid to trade it. The currencies keep their own columns. %>
          <% unless hide_balances %><th><%= t('tracker.columns.amount') %></th><% end %>
          <th><%= t('tracker.columns.quote') %></th>
          <% unless hide_balances %>
            <th><%= t('tracker.columns.quote_amount') %></th>
            <th><%= t('tracker.columns.fee') %></th>
          <% end %>
          <th><%= t('tracker.columns.bot') %></th>
        </tr>
      </thead>
      <tbody>
        <% @account_transactions.each do |at| %>
          <%= render 'transaction_row', at: at %>
        <% end %>
      </tbody>
    </table>
  </div>
<% elsif @exchanges.any? %>
  <div class="tracker-empty">
    <p><%= t('tracker.no_results') %></p>
  </div>
<% end %>
<% end %>
