<%# The bar above the card, as on the bot view: the scope on the left, the sync state on the right.
    The switch is NAVIGATION — every option is a link and the server decides which is current — so
    it scopes everything below it: the holdings card, the transactions and the positions. The chart
    and the tiles above stay whole-portfolio. %>
<div class="tracker-exchanges">
  <div class="filters">
    <%# Same rule as every other filter here — one venue is not a choice — with one exception: a
        broken key wears its alarm on its own chip, so a lone venue whose key has stopped working
        keeps the control that says so. %>
    <% broken = @exchanges.any? { |exchange| !@exchanges_with_valid_keys.include?(exchange.id) && !exchange.retired? } %>
    <%# The + belongs to the venues it adds to, so it rides INSIDE the switch — a glyph stranded at
        the far end of the row is a control the reader has to guess at. One destination either way:
        the picker modal, which searches every venue we support and prints its fees. A dropdown of
        its own would have to open inside the switch's own menu once that folds. %>
    <% connect = { href: new_tracker_pick_exchange_path, label: t('tracker.connect_exchange'),
                   icon: 'svg/24x24_plus', data: { turbo_frame: 'modal' } } %>
    <% if @exchanges.many? || broken %>
      <% options = [{ value: 'all', label: t('tracker.filters.all'), active: @scope_exchange.nil?,
                      href: tracker_path(from: params[:from], to: params[:to]) }] %>
      <% @exchanges.each do |exchange| %>
        <%# @exchanges comes from api_keys PLUS account_transactions, so a retired venue still shows
            up for its history. It filters like any other, but must never offer to reconnect —
            there is nothing left to connect to. A broken key keeps its chip and swaps the link for
            the re-add form, which is what the reader wants from it. %>
        <% if @exchanges_with_valid_keys.include?(exchange.id) || exchange.retired? %>
          <% options << { value: exchange.id.to_s, label: exchange.name,
                          active: @scope_exchange&.id == exchange.id,
                          href: tracker_path(exchange_id: exchange.id, from: params[:from], to: params[:to]) } %>
        <% else %>
          <% options << { value: exchange.id.to_s, label: exchange.name, active: false,
                          href: new_tracker_add_api_key_path(exchange_id: exchange.id),
                          data: { broken: true, turbo_frame: 'modal' } } %>
        <% end %>
      <% end %>
      <%# Fluid: the option count is the user's exchange list and the labels are venue names, so
          equal columns would give every one of them the width of the longest. %>
      <%= render 'shared/segmented', fluid: true, label: t('tracker.filters.all'),
                 options: options, action: connect %>
    <% else %>
      <%# No switch to ride in — one venue is not a scope to choose between — so it stands alone. %>
      <%= link_to connect[:href], class: 'rbutton rbutton--icon', data: connect[:data],
                  aria: { label: connect[:label] } do %>
        <%= render connect[:icon] %>
      <% end %>
    <% end %>
  </div>

  <%# The far end of the line: what the page can hand you, after the scope that decides what goes
      into it. Both read the venue and the dates from the same params the switch writes. %>
  <div class="tracker-exchanges__end">
    <div class="tracker-exchanges__sync">
      <% if @portfolio_last_synced_at %>
        <%# Amber when the prices are older than the balances: the quantities are today's, the money
            beside them is not. %>
        <span class="label tracker-sync <%= 'tracker-sync--stale' if @portfolio_has_stale_prices %>">
          <i class="tracker-sync__dot"></i><%= tracker_synced_ago(@portfolio_last_synced_at) %>
        </span>
      <% end %>
      <% if @has_syncable_keys %>
        <%= button_to sync_tracker_path, method: :post, class: 'rbutton rbutton--icon', aria: { label: t('tracker.sync') } do %>
          <%= render 'svg/24x24_sync' %>
        <% end %>
      <% end %>
    </div>

    <%= link_to t('bot.details.stats.download_csv'),
                export_tracker_path(exchange_id: params[:exchange_id], from: params[:from], to: params[:to]),
                class: 'rbutton' %>
    <%# Beside the export, because it reads the same file the export writes — plus the venues' own. %>
    <%= link_to t('tracker.import.title'), new_tracker_import_path, class: 'rbutton',
                data: { turbo_frame: 'modal' } %>
    <% if @exchanges.any? %>
      <%= link_to t('tracker.get_report'), export_modal_tracker_path, class: 'rbutton', data: { turbo_frame: 'modal' } %>
    <% end %>
  </div>
</div>
