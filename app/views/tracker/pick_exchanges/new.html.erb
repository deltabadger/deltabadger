<%= render 'layouts/modal/full_page', close_url: tracker_path do %>
  <div class="bot-creation-layout">
    <%= render 'bots/new_step_progress_bar', current_step: :exchange, steps: { exchange: 50, connect: 100 } %>

    <div class="conversational conversational--bot-setup">
      <%# No search box: the tiles below are the input. %>
      <%= t('tracker.import_from') %>
    </div>

    <%= render "bots/pick_exchanges/table",
               exchanges: @exchanges,
               submit_url: tracker_pick_exchange_path,
               param_name: 'exchange_id',
               trading: false %>
  </div>
<% end %>
