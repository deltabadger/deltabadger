<%= render 'layouts/modal/base' do %>
  <div class="modal">
    <%= button_tag type: 'button', class: 'modal__close', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
      <%= render partial: 'svg/24x24_close' %>
    <% end %>
    <div class="modal__header">
      <h1 class="modal__title"><%= @rule.asset.symbol %> — <%= @rule.exchange.name %></h1>
    </div>
    <div class="modal__body">
      <p><%= t('rules.withdrawals.confirm_destroy.message') %></p>
      <div class="modal__footer">
        <%= button_tag type: 'button', class: 'rbutton rbutton--secondary', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
          <%= t('button.cancel') %>
        <% end %>
        <%= button_to t('button.delete'), rules_withdrawal_path(@rule), method: :delete, class: 'rbutton rbutton--danger', data: { turbo_stream: true, action: 'modal--base#animateOutCloseAndCleanUp' } %>
      </div>
    </div>
  </div>
<% end %>
