<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="UTF-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="ie=edge" http-equiv="X-UA-Compatible">
    <meta name="color-scheme" content="dark light">
    <meta name="theme-color" content="#f5f6f8" id="theme-color-meta">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="turbo-prefetch" content="false">

    <title><%= content_for?(:title) ? yield(:title) : t('meta.title') %></title>
    <%= render 'application/favicon' %>

    <%= javascript_include_tag "tauri_boot" %>
    <%= stylesheet_link_tag 'application', media: 'all', "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <%= yield :head if content_for?(:head) %>
  </head>

  <%# hide-balances rides on the BODY, not on <html>: Turbo replaces the body on every visit and on
      a stream refresh, but never touches <html>'s attributes — a class up there would go stale the
      moment the toggle refreshed the page. %>
  <%= tag.body data: { controller: "hotwire-animations app-wake ticker-tooltips reveal-chrome", locale: I18n.locale },
               class: [('hide-chrome' if content_for?(:hide_chrome)), ('hide-balances' if current_user&.hide_balances?)].compact.presence do %>

    <div data-tauri-drag-region class="titlebar-drag-region"></div>

    <div class="flash-stack">
      <div id="flash" data-turbo-permanent>
        <%= render 'layouts/flash' %>
        <%= render 'layouts/flash_syncing' if AppConfig.setup_sync_in_progress? %>
      </div>
      <%= yield :flash_extra %>
    </div>

    <%= render 'layouts/navbar' %>

    <main class="main">
      <div class="main-content">
        <%= yield %>
      </div>
    </main>

    <%= turbo_frame_tag 'modal', src: (content_for(:modal_src) if content_for?(:modal_src)) %>

  <% end %>
</html>