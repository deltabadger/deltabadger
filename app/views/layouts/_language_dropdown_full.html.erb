<div data-controller="dropdown" data-action="click->dropdown#toggle" data-dropdown-target="wrapper" class="sbutton sbutton--link dropdown-wrapper <%= extra_classes %>">
  <% locale = params[:locale] %>
  <% language_names = { 'en' => 'English', 'de' => 'Deutsch', 'nl' => 'Nederlands', 'fr' => 'Français', 'es' => 'Español', 'pt' => 'Português', 'it' => 'Italiano', 'pl' => 'Polski', 'ru' => 'Русский', 'cs' => 'Čeština', 'sk' => 'Slovenčina', 'da' => 'Dansk', 'sv' => 'Svenska', 'el' => 'Ελληνικά', 'bg' => 'Български' } %>
  <%= language_names[I18n.locale.to_s] || 'English' %> <%= render "svg/16x16_down" %>
  <div class="dropdown">
    <% unless locale.blank? || locale == 'en' %>
      <%= link_to "🇬🇧 English", locale_switch_path('en'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'de' %>
      <%= link_to "🇩🇪 Deutsch", locale_switch_path('de'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'nl' %>
      <%= link_to "🇳🇱 Nederlands", locale_switch_path('nl'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'fr' %>
      <%= link_to "🇫🇷 Français", locale_switch_path('fr'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'es' %>
      <%= link_to "🇪🇸 Español", locale_switch_path('es'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'pt' %>
      <%= link_to "🇵🇹 Português", locale_switch_path('pt'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'it' %>
      <%= link_to "🇮🇹 Italiano", locale_switch_path('it'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'pl' %>
      <%= link_to "🇵🇱 Polski", locale_switch_path('pl'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'ru' %>
      <%= link_to "🇷🇺 Русский", locale_switch_path('ru'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'cs' %>
      <%= link_to "🇨🇿 Čeština", locale_switch_path('cs'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'sk' %>
      <%= link_to "🇸🇰 Slovenčina", locale_switch_path('sk'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'da' %>
      <%= link_to "🇩🇰 Dansk", locale_switch_path('da'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'sv' %>
      <%= link_to "🇸🇪 Svenska", locale_switch_path('sv'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'el' %>
      <%= link_to "🇬🇷 Ελληνικά", locale_switch_path('el'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
    <% unless locale == 'bg' %>
      <%= link_to "🇧🇬 Български", locale_switch_path('bg'), class: "dropdown__item", data: { turbo: false } %>
    <% end %>
  </div>
</div>
