<%# Small round asset logo; falls back to the asset's own colour when it has no image.
    `symbol`/`category` are what cash is drawn from — see ApplicationHelper#asset_logo_url. %>
<% src = asset_logo_url(image_url, symbol: local_assigns[:symbol], category: local_assigns[:category]) %>
<% if src.present? %>
  <img class="asset-logo" src="<%= src %>" alt="" loading="lazy">
<% else %>
  <span class="asset-logo" style="background: <%= ensure_contrast(color || '#8A9BA8') %>"></span>
<% end %>
