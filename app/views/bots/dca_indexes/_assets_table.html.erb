<%# locals: (values:, logo_assets:, body_id: nil, bot: nil, sellable: false) %>
<%# Index holdings come from the metrics hash, not from the bot's own columns, so they need mapping
    onto the shared table's rows. Used for the index itself, the coins that left it, and the sale's
    confirmation — only the quitters table passes sellable, because a constituent is not for sale. %>
<%= render 'bots/assets_table', body_id: body_id, actions: sellable, rows: values.map { |symbol, data|
      { asset: logo_assets[symbol]&.base_asset, symbol: symbol,
        amount: number_with_precision(data[:amount] || 0, precision: 6, strip_insignificant_zeros: true),
        avg_price: number_with_precision(data[:avg_price] || 0, precision: 2, delimiter: ','),
        value: number_with_precision(data[:current_value] || 0, precision: 2, delimiter: ','),
        pnl: data[:pnl_percentage] || 0,
        action: (sellable ? link_to(t('bot.liquidation.sell'),
                                    new_bot_liquidation_path(bot_id: bot.id, symbol: symbol),
                                    class: 'rbutton rbutton--danger rbutton--small',
                                    data: { turbo_frame: 'modal' }) : nil) }
    } %>
