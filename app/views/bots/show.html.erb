<%= turbo_stream_from "user_#{current_user.id}", :bot_updates %>

<%= turbo_frame_tag "bot" do %>
  <%= tag.div data: @chart_loading ? { controller: "broadcast--on-connect",
                                      broadcast__on_connect_method_value: "metrics_update",
                                      broadcast__on_connect_method_args_value: { bot_id: @bot.id }.to_json } : {} %>
  <div class="page-head">
    <%= render "bots/header", bot: @bot, other_bots: @other_bots %>
  </div>
  <div class="flex-column gap-1">
    <div class="bot-control">
      <%= render partial: "bots/exchange_select", locals: { bot: @bot } %>
      <%= render partial: "bots/status/status_bar", locals: { bot: @bot } %>
      <%= render partial: "bots/status/status_button", locals: { bot: @bot } %>
    </div>

    <%= render partial: "bots/chart", locals: { bot: @bot, metrics: @chart_metrics, loading: @chart_loading } %>

    <div id="<%= dom_id(@bot, :columns) %>" class="columns<%= ' bot-locked' if @bot.working? %>">
      <div class="column gap-1">
        <% if @bot.dca_single_asset? %>
          <%= render partial: "bots/dca_single_assets/settings", locals: { bot: @bot } %>
        <% elsif @bot.dca_dual_asset? %>
          <%= render partial: "bots/dca_dual_assets/settings", locals: { bot: @bot } %>
        <% elsif @bot.dca_index? %>
          <%= render partial: "bots/dca_indexes/settings", locals: { bot: @bot, index_preview: @index_preview } %>
        <% elsif @bot.dca_multi_asset? %>
          <%= render partial: "bots/dca_multi_assets/settings", locals: { bot: @bot } %>
        <% elsif @bot.signal? %>
          <%= render partial: "bots/signals/settings", locals: { bot: @bot } %>
        <% end %>
      </div>
      <div class="column gap-1">
        <% if @bot.dca_single_asset? %>
          <%= render partial: "bots/dca_single_assets/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading } %>
        <% elsif @bot.dca_dual_asset? %>
          <%= render partial: "bots/dca_dual_assets/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading } %>
        <% elsif @bot.dca_index? %>
          <%= render partial: "bots/composition/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading, exited_title_key: @bot.exited_title_key } %>
        <% elsif @bot.dca_multi_asset? %>
          <%= render partial: "bots/composition/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading, exited_title_key: @bot.exited_title_key } %>
        <% elsif @bot.signal? %>
          <%= render partial: "bots/dca_single_assets/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading } %>
        <% end %>
        <%= render partial: "bots/orders/orders", locals: { bot: @bot, decimals: @decimals } %>
      </div>
    </div>
  </div>
<% end %>
