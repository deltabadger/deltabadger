<%# A hide-balances toggle in another tab refreshes this one. Subscribed per page rather than in
    the layout: the refresh REPLACES the document, so a settings or setup page listening for it
    would throw away whatever the user had half-typed into an email, password or API-key form.
    Only the pages that state balances have anything to re-render. %>
<%= turbo_stream_from "user_#{current_user.id}", :preferences %>
<%= turbo_stream_from "user_#{current_user.id}", :bot_updates %>

<%# The catch-all seam for the one-time wash-sale question: the turbo_stream actions carry it
    themselves, and this reaches everyone else — including users who armed selling before the
    question existed. %>
<% if wash_sale_prompt_due?(@bot) || wash_sale_selling_warning_due?(@bot) %>
  <% content_for :modal_src, new_bot_wash_sale_prompt_path(bot_id: @bot.id) %>
<% end %>

<%= turbo_frame_tag "bot" do %>
  <%# This bot's own panels (Bot#page_stream): replaced by ids every bot page shares, so they must not
      arrive on the stream every page of the user listens to. Inside the frame, because the bot
      switcher swaps only the frame: out here it would outlast the swap and keep listening to the bot
      the page just left. %>
  <%= turbo_stream_from(*@bot.page_stream) %>
  <%# The switcher swaps only this frame, so the layout's modal source above is never looked at again:
      the modal due for the bot switched to arrives here instead, as a stream that runs when it
      connects. Frame requests only — a full load already has the modal source, and would show it twice. %>
  <%= wash_sale_prompt_stream(@bot) if turbo_frame_request? %>
  <%= tag.div data: @chart_loading ? { controller: "broadcast--on-connect",
                                      broadcast__on_connect_method_value: "metrics_update",
                                      broadcast__on_connect_method_args_value: { bot_id: @bot.id }.to_json } : {} %>
  <div class="page-head">
    <%= render "bots/header", bot: @bot, other_bots: @other_bots %>
  </div>
  <div class="flex-column gap-1">
    <div class="bot-control">
      <%= render partial: "bots/exchange_select", locals: { bot: @bot } %>
      <%= render partial: "bots/status/status_bar", locals: { bot: @bot } %>
      <%= render partial: "bots/status/status_button", locals: { bot: @bot } %>
    </div>

    <%= render partial: "bots/chart", locals: { bot: @bot, metrics: @chart_metrics, loading: @chart_loading } %>

    <div id="<%= dom_id(@bot, :columns) %>" class="columns<%= ' bot-locked' if @bot.working? %>">
      <div class="column gap-1">
        <% if @bot.dca_single_asset? %>
          <%= render partial: "bots/dca_single_assets/settings", locals: { bot: @bot } %>
        <% elsif @bot.dca_index? %>
          <%= render partial: "bots/dca_indexes/settings", locals: { bot: @bot, index_preview: @index_preview } %>
        <% elsif @bot.dca_multi_asset? %>
          <%= render partial: "bots/dca_multi_assets/settings", locals: { bot: @bot } %>
        <% elsif @bot.signal? %>
          <%= render partial: "bots/signals/settings", locals: { bot: @bot } %>
        <% end %>
      </div>
      <div class="column gap-1">
        <% if @bot.dca_single_asset? %>
          <%= render partial: "bots/dca_single_assets/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading } %>
        <% elsif @bot.dca_index? %>
          <%= render partial: "bots/composition/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading, exited_title_key: @bot.exited_title_key } %>
        <% elsif @bot.dca_multi_asset? %>
          <%= render partial: "bots/composition/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading, exited_title_key: @bot.exited_title_key } %>
        <% elsif @bot.signal? %>
          <%= render partial: "bots/dca_single_assets/metrics", locals: { bot: @bot, metrics: @metrics, loading: @metrics_loading } %>
        <% end %>
        <%= render partial: "bots/orders/orders", locals: { bot: @bot, decimals: @decimals } %>
      </div>
    </div>
  </div>
<% end %>
