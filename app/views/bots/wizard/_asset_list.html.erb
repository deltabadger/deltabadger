<%= link_to new_bots_dca_multi_assets_pick_assets_path,
            class: 'wizard-asset-list',
            data: { turbo_frame: 'modal_content', wizard_dir: 'back' } do %>
  <% assets.each do |asset| %>
    <%= tag.div asset.symbol,
                class: ticker_class(asset),
                style: "background: #{ensure_contrast(asset.color || '#8A9BA8')}",
                data: ticker_data(asset) %>
  <% end %>
<% end %>
