<%#
  Unified conversational sentence for the DCA wizard:
  "Buy {assets} on {exchange} spending {quote}".

  Each slot is one of:
    active  — this slot's step == current_step → editable search input
    filled  — its value is already chosen       → chip linking back to it
    future  — not chosen yet                     → muted placeholder

  The asset slot holds the whole basket as one stack of chips: away from the asset
  step the stack is a single link back to it (adding and removing happen there, in
  the table under the sentence); on the asset step it is inert — the search box sits
  above the list, not in the sentence — and an empty basket shows a muted "…".

  Placeholders double as controls. On the FIRST step, while nothing is chosen, the
  not-yet-active of {asset, exchange} flips the order (POST) so that slot is picked
  first — on the default first step (the exchange step) the whole sentence is that
  invitation: "You can also start with assets". On the asset step, once something is chosen, the exchange/spending
  placeholders — and the filled exchange chip — POST `advance`, the one way out of
  the step (it commits the basket before any later step reads it). Elsewhere a
  placeholder is inert: switching would discard the pick.

  Locals:
    bot:          @bot (DcaSingleAsset or DcaMultiAsset)
    current_step: :currencies | :exchange | :api | :spendable
    chosen:       (optional) the chosen Assets in pick order — the asset step passes its basket
    multi:        (optional) whether the basket continues as a multi bot — selects the namespace
%>
<%
  order   = current_order
  on_first_step = order.first?(current_step)
  on_asset_step = current_step == :currencies

  multi    = local_assigns.fetch(:multi) { bot.is_a?(Bots::DcaMultiAsset) }
  chosen   = local_assigns.fetch(:chosen) { multi ? bot.base_assets : [bot.base_asset].compact }
  exchange = bot.exchange_id.present? ? bot.exchange : nil

  exchange_state = if current_step == :exchange then :active
                   elsif exchange then :filled
                   else :future
                   end

  # Spending shows only after an asset and an exchange are both chosen.
  quote_visible = chosen.any? && exchange.present?

  asset_step_url = new_bots_dca_single_assets_pick_buyable_asset_path
  advance_url    = advance_bots_dca_single_assets_pick_buyable_asset_path
  order_url      = bots_dca_single_assets_order_path
  exchange_url   = multi ? new_bots_dca_multi_assets_pick_exchange_path : new_bots_dca_single_assets_pick_exchange_path
  quote_search_url = multi ? new_bots_dca_multi_assets_pick_spendable_asset_path : new_bots_dca_single_assets_pick_spendable_asset_path

  # The default first step has nothing to narrate yet: the sentence only offers the other route.
  invite_only = current_step == :exchange && on_first_step && chosen.empty?

  # The stack previews the first few members and counts the rest, like the index previews.
  stack_limit = 5
  stack_class = case chosen.size
                when 0, 1 then ''
                when 2 then 'ticker-group--2'
                else 'ticker-group--many'
                end
%>

<div class="conversational conversational--bot-setup"
     data-bot-kind="<%= multi ? 'multi' : 'single' %>" data-wizard-step="<%= current_step %>"
     data-controller="conversational-sentence"
     data-action="click->conversational-sentence#activate input->conversational-sentence#updateFilled">

  <% if invite_only %>
    <span class="conversational__lead">You can also start with</span>
    <%= form_with url: order_url, method: :post, class: "conversational__link conversational__link--switch",
                  data: { turbo_frame: "modal_content" } do |f| %>
      <%= f.hidden_field :flow, value: "asset_first" %>
      <input value="assets" readonly tabindex="-1">
    <% end %>
  <% else %>
  <span class="conversational__lead">Buy</span>

  <div class="conversational__assets">
    <% if chosen.any? %>
      <% stack_options = { class: "conversational__stack ticker-group #{stack_class}".strip } %>
      <% stack_options.merge!(href: asset_step_url, data: { turbo_frame: 'modal_content', wizard_dir: 'back' }) unless on_asset_step %>
      <%= content_tag(on_asset_step ? :div : :a, **stack_options) do %>
        <% chosen.first(stack_limit).each do |asset| %>
          <%= tag.div asset.symbol, class: ticker_class(asset),
                      style: "background: #{ensure_contrast(asset.color || '#8A9BA8')}", data: ticker_data(asset) %>
        <% end %>
        <% if chosen.size > stack_limit %>
          <div class="ticker ticker--more">+<%= chosen.size - stack_limit %></div>
        <% end %>
      <% end %>
    <% end %>

    <% if on_asset_step %>
      <% if chosen.empty? %>
        <span class="ticker ticker--placeholder">…</span>
      <% end %>
    <% elsif chosen.empty? %>
      <%# Asset not chosen yet (exchange-first): clicking the slot switches to
          asset-first so the asset is picked first. Available on every step the
          asset is still pending — including while adding the API key — since the
          asset is the primary choice and nothing committed is the asset itself. %>
      <%= form_with url: order_url, method: :post, class: "ticker ticker--placeholder ticker--switch",
                    data: { turbo_frame: "modal_content" } do |f| %>
        <%= f.hidden_field :flow, value: "asset_first" %>
        <input placeholder="…" readonly tabindex="-1">
      <% end %>
    <% end %>
  </div>

  <%# ── exchange slot ── %>
  <span class="conversational__lead">on</span>
  <% if exchange_state == :active %>
    <%= form_with url: exchange_url, method: :get,
                  data: { controller: "form--submit-after-delay", turbo_frame: "exchange-picker" },
                  class: "conversational__link active" do |f| %>
      <%= f.text_field :query, autofocus: true, autocomplete: "off", placeholder: "exchange",
                       data: { action: "input->form--submit-after-delay#submit" } %>
    <% end %>
  <% elsif exchange_state == :filled && on_asset_step %>
    <%# Leaving the asset step always goes through advance, which commits the basket first. %>
    <%= form_with url: advance_url, method: :post, class: "conversational__link filled",
                  data: { turbo_frame: "modal_content" } do |f| %>
      <%= f.hidden_field :to, value: "exchange" %>
      <input value="<%= exchange.name %>" readonly tabindex="-1">
    <% end %>
  <% elsif exchange_state == :filled %>
    <%= form_with url: exchange_url, method: :get, class: "conversational__link filled",
                  data: { turbo_frame: "modal_content", wizard_dir: "back" } do %>
      <input value="<%= exchange.name %>" readonly tabindex="-1">
    <% end %>
  <% elsif on_first_step && chosen.empty? %>
    <%# Asset-first first step: clicking the exchange slot switches to exchange-first. %>
    <%= form_with url: order_url, method: :post,
                  class: "conversational__link conversational__link--placeholder conversational__link--switch",
                  data: { turbo_frame: "modal_content" } do |f| %>
      <%= f.hidden_field :flow, value: "exchange_first" %>
      <input placeholder="exchange" readonly tabindex="-1">
    <% end %>
  <% elsif on_asset_step %>
    <%= form_with url: advance_url, method: :post,
                  class: "conversational__link conversational__link--placeholder conversational__link--advance",
                  data: { turbo_frame: "modal_content" } do %>
      <input placeholder="exchange" readonly tabindex="-1">
    <% end %>
  <% else %>
    <span class="conversational__link conversational__link--placeholder">exchange</span>
  <% end %>

  <%# ── quote (spending) slot — only once an asset and an exchange are chosen ── %>
  <% if quote_visible %>
    <span class="conversational__lead">spending</span>
    <% if current_step == :spendable %>
      <%= form_with url: quote_search_url, method: :get,
                    data: { controller: "form--submit-after-delay", turbo_frame: "asset-picker" },
                    class: "ticker active" do |f| %>
        <%= f.text_field :query, autofocus: true, autocomplete: "off", placeholder: "USD",
                         data: { action: "input->form--submit-after-delay#submit" } %>
      <% end %>
    <% elsif on_asset_step %>
      <%= form_with url: advance_url, method: :post, class: "ticker ticker--placeholder ticker--advance",
                    data: { turbo_frame: "modal_content" } do %>
        <input placeholder="…" readonly tabindex="-1">
      <% end %>
    <% else %>
      <span class="ticker ticker--placeholder">…</span>
    <% end %>
  <% end %>
  <% end %>
</div>
