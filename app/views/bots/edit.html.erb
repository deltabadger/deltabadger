<%= render 'layouts/modal/base' do %>
  <div class="modal">
    <%= button_tag type: 'button', class: 'modal__close', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
      <%= render partial: 'svg/24x24_close' %>
    <% end %>
    <div class="modal__header">
       <h1 class="modal__title"><%= t('utils.change_name') %></h1>
    </div>

    <%= form_with model: @bot, url: bot_path(@bot), method: :patch, data: { action: "turbo:submit-end->modal--base#submitEnd" } do |f| %>
      <%= f.text_field :label, autofocus: true, data: { controller: "autofocus" }, class: "rinput rinput--outline rinput--text full-width",
                               aria: { label: t('bot.bot_name') } %>
      <div class="modal__footer">
        <%= button_tag t('button.cancel'), type: 'button', class: 'rbutton rbutton--secondary', data: { action: 'modal--base#animateOutCloseAndCleanUp' } %>
        <%= f.submit t('button.save'), class: "rbutton rbutton--primary" %>
      </div>
    <% end %>

  </div>
<% end %>
