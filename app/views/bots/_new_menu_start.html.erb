<div class="welcome-screen">
    <p><%= t('bot.welcome.pick_exchange_first') %></p>
    <%# Stocks onboarding line, by catalog state: catalog present or admin →
        nothing (stocks just show up in the picker; admins bootstrap Alpaca
        from Settings, or get asked for it in the bot-creation wizard);
        no catalog + non-admin → ask your admin. %>
    <% if !StockTradingSettings.active? && !current_user.admin? %>
      <p><%= t('bot.setup.stocks_ask_admin') %></p>
    <% end %>
    <div style="margin-top: 2rem; transform: scale(1.5)">
        <%= button_to new_bot_path, method: :get, class: "sbutton sbutton--sky", data: { turbo_frame: "modal" }, aria: { label: t('bot.new') } do %>
            <span class="d-none d-sm-inline"><%= t('bot.new') %></span>
            <%= render partial: 'svg/24x24_plus' %>
        <% end %>
    </div>
</div>