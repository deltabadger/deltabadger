<% tabs = local_assigns.fetch(:tabs) { order_filter_tabs(bot) } %>
<%# More than one NAMED category: "All" (when it is offered at all) is not a category of its own,
    it is every row, so a bot whose rows all fall in one place still needs no control. %>
<% show_filters = tabs.count { |value, _, available| available && value != 'all' } > 1 %>

<% order_filter = params[:order_filter] || default_order_filter(tabs) %>
<%# Fluid: the option COUNT depends on what the bot actually has (a bot that never skipped a
    contribution gets no Other tab), and the labels differ in width, so equal columns would resize the
    whole control from bot to bot. The order-filter controller still does the filtering; it just
    hears about the choice through the segmented control's event now. %>
<%# "Other" last: it is the catch-all for what the named tabs don't want — cancelled,
    skipped, failed — and it shows those rows as their message, not as columns. %>
<%# data-order-filter-default lives HERE, on the element the broadcast replaces, and not on the
    controller's own element, which nothing ever replaces. It is the fallback for "the tab I was on
    no longer exists", so it has to be as fresh as the tabs beside it: parked upstream it would
    freeze at page-load time and send the reader to a tab that has since disappeared. %>
<div id="<%= dom_id(bot, :order_filters) %>" class="filters" data-order-filter-target="filterContainer"
     data-order-filter-default="<%= default_order_filter(tabs) %>"
     data-action="segmented:change->order-filter#filter">
  <% if show_filters %>
    <%= render 'shared/segmented', fluid: true, label: t('order_filters.all'),
               options: tabs.select(&:last).map { |value, label, _|
                 { value: value, label: label, active: order_filter == value }
               } %>
  <% end %>
</div>
