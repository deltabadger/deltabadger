<%= tag.tr id: dom_id(order), class: order.failed? ? 'text-danger' : (inactive_order_row?(order) ? 'text-inactive' : ''), data: { hw_animate_in_prepend: "animate-order-in", order_filter_target: "row", order_type: order_filter_type(order) } do %>
  <td scope="row"><%= order.created_at.in_time_zone(current_user.time_zone).strftime("%Y-%m-%d %I:%M %p") %></td>

  <% show_executed_amounts = order.submitted? && order.closed? %>
  <% executed_amount = order.amount_exec || order.amount %>
  <% executed_quote_amount = order.quote_amount_exec || order.quote_amount %>

  <% amount = show_executed_amounts ? executed_amount : order.amount %>
  <td><%= amount.nil? ? '-' : decimals[order.base].nil? ? amount : amount.round(decimals[order.base]) %> <%= order.base %></td>

  <% quote_amount = show_executed_amounts ? executed_quote_amount : order.quote_amount %>
  <% quote_amount = order.price * amount if quote_amount.nil? && order.price.present? && amount.present? %>
  <td><%= quote_amount.nil? ? '-' : decimals[order.quote].nil? ? quote_amount : quote_amount.round(decimals[order.quote]) %> <%= order.quote %></td>

  <% unit_price = (amount && quote_amount && !amount.zero?) ? quote_amount / amount : nil %>
  <td><% if unit_price.nil? %>-<% else %><%= decimals[order.quote].nil? ? unit_price : unit_price.round(decimals[order.quote]) %> <%= order.quote %><% end %></td>

  <td>
    <% if order.open? %>
      <div data-controller="class-toggle" data-class-toggle-toggle-classes-value='["hidden"]'>
        <%= button_to t('bot.cancel_order'), bot_transaction_path(order.bot, order), method: :delete, class: 'sinput sinput--small sinput--hover-warning', data: { class_toggle_target: "togglable", action: "click->class-toggle#toggle" } %>
        <div class="loader--small hidden" style="position: unset; float: right; margin-right: 0.5rem;" data-class-toggle-target="togglable" ></div>
      </div>
    <% end %>
  </td>
<% end %>