<%# Transaction rendered as a sentence for the unified "All" timeline. The columnar
    Date|Amount|Value layout (_order) is used by the Transactions/Scheduled tabs instead.
    data-order-type lists the tabs this row shows under: "all", plus "other" for the rows
    with no columnar home (cancelled, abandoned, skipped, failed) — the sentence IS what
    the Other tab has to show.

    While balances are hidden there is no "All" tab: the sentence spells the money out, which is
    what that tab was. A row that is not `other?` therefore has nothing to show — but it still has
    to EXIST, because Bot#broadcast_updated_order *replaces* this id and a replace with no target
    is dropped on the floor. Without the empty placeholder, an open order that is later cancelled
    would never get its Other sentence until the page was reloaded. "" belongs to no tab, so the
    filter keeps it hidden. %>
<% hidden = hide_balances?(order.bot) %>
<% if hidden && !order.other? %>
  <%= tag.tr id: dom_id(order, :timeline), data: { order_filter_target: "row", order_type: "" } %>
<% else %>
  <% row_class = order.failed? ? 'text-danger' : (inactive_order_row?(order) ? 'text-inactive' : '') %>
  <%= tag.tr id: dom_id(order, :timeline), class: row_class, data: { hw_animate_in_prepend: "animate-order-in", order_filter_target: "row", order_type: hidden ? "other" : (order.other? ? "all other" : "all") } do %>
    <td scope="row" class="table__when"><%= table_when(order.created_at, current_user.time_zone) %></td>
    <td colspan="<%= hidden ? 1 : 3 %>" class="table__sentence"><%= transaction_summary(order, decimals) %></td>
    <td>
      <% if order.open? %>
        <div data-controller="class-toggle" data-class-toggle-toggle-classes-value='["hidden"]'>
          <%= button_to t('bot.cancel_order'), bot_transaction_path(order.bot, order), method: :delete, class: 'sinput sinput--small sinput--hover-warning', data: { class_toggle_target: "togglable", action: "click->class-toggle#toggle" } %>
          <div class="loader--small hidden" style="position: unset; float: right; margin-right: 0.5rem;" data-class-toggle-target="togglable"></div>
        </div>
      <% end %>
    </td>
  <% end %>
<% end %>
