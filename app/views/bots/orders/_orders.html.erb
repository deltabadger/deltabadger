<% has_waiting = bot.transactions.waiting.exists? %>
<% hide_money = hide_balances?(bot) %>
<%# Computed once and handed down: the filter row asks the same questions of the same bot, and it
    only recomputes them for itself when a broadcast renders it on its own. %>
<% tabs = order_filter_tabs(bot) %>

<% order_filter = params[:order_filter] || default_order_filter(tabs) %>
<div data-controller="order-filter" data-order-filter-current-value="<%= order_filter %>" style="gap: 1rem; display: flex; flex-direction: column">

  <div style="display: flex; justify-content: space-between; align-items: center;">
    <%= render 'bots/orders/order_filters', bot: bot, tabs: tabs %>
    <%= render 'bots/orders/export', bot: bot %>
  </div>

  <%= tag.div class: "widget widget--table", data: has_waiting ? {
    controller: "table-fit broadcast--on-connect",
    broadcast__on_connect_method_value: "fetch_open_orders",
    broadcast__on_connect_method_args_value: { bot_id: bot.id }.to_json
  } : { controller: "table-fit" } do %>
    <table class="table">
      <thead>
        <tr>
          <th scope="col"><%= t('data_labels.date') %></th>
          <% unless hide_money %>
            <th scope="col" data-order-filter-target="columnHeader"><%= t('data_labels.amount') %></th>
            <th scope="col" data-order-filter-target="columnHeader"><%= t('data_labels.value') %></th>
          <% end %>
          <th scope="col" data-order-filter-target="columnHeader"><%= t('data_labels.price') %></th>
          <th></th>
        </tr>
      </thead>
      <tbody id="orders_list">
        <% if BotActivityFeed.new(bot: bot, limit: 1).items.empty? %>
          <tr id="orders_list_placeholder">
            <td colspan="<%= hide_money ? 3 : 5 %>" class="text-center text-inactive" style="padding-bottom: 2rem;">. . .</td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <%= turbo_frame_tag 'orders_pagination', src: bot_path(bot, format: :turbo_stream, params: { decimals: decimals }) %>
  <% end %>
</div>