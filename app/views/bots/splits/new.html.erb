<%# What the split will do, in the words the POST then acts on. Everything sits in the split_modal frame,
    refusal included, so bots_split_modal_controller can re-fetch it while a reinvestment settles and
    always find its frame. The controller lives outside the frame and keeps the user's No answers. %>
<%= render 'layouts/modal/base' do %>
  <%= tag.div class: 'modal', data: { controller: 'bots-split-modal',
                                      bots_split_modal_url_value: new_bots_split_path(ids: @split.bots.map(&:id)) } do %>
    <%= turbo_frame_tag 'split_modal' do %>
      <%= button_tag type: 'button', class: 'modal__close', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
        <%= render partial: 'svg/24x24_close' %>
      <% end %>
      <% refusal = @split.refusal %>
      <div class="modal__header">
        <h1 class="modal__title"><%= t('button.split') %></h1>
      </div>
      <div class="modal__body text-center">
        <% if refusal %>
          <p><%= refusal %></p>
          <div class="buttons">
            <%= button_tag t('button.close'), type: 'button', class: 'button button--outline button--large',
                           data: { action: 'modal--base#animateOutCloseAndCleanUp' } %>
          </div>
        <% else %>
          <%# One row per bot whose sale proceeds still wait for an answer. Yes is the bot page's own
              redeploy; No is kept here until Split posts it as keep_ids[]. Halted is checked first: an
              ambiguous redeploy also reads as in flight. %>
          <% @split.bots.each do |bot| %>
            <% offer = @split.offers[bot] %>
            <% state = if @split.halted?(bot) then 'halted'
                       elsif @split.reinvesting?(bot) then 'pending'
                       elsif offer.positive? then 'offer'
                       end %>
            <% next unless state %>
            <%= tag.div class: 'split-modal__row mb-3', data: { split_row: state, bot_id: bot.id } do %>
              <% if state == 'halted' %>
                <p class="text-danger"><%= bot.label %>: <%= t('bot.redeploy.halted') %></p>
              <% elsif state == 'pending' %>
                <p><%= t('bot.split.reinvesting', label: bot.label) %> <%= redeploy_answer_spinner(t('bot.redeploy.started')) %></p>
              <% else %>
                <p><%= t('bot.split.proceeds', label: bot.label,
                         amount: number_with_precision(offer, precision: 2, delimiter: ','),
                         symbol: bot.quote_asset&.symbol) %></p>
                <div class="redeploy-prompt__actions split-modal__answers" data-split-actions>
                  <%= button_to t('bot.redeploy.confirm'), bot_redeploy_path(bot_id: bot.id),
                                class: 'rbutton rbutton--success', form: { data: { split_answer: true } } %>
                  <%= button_tag t('bot.redeploy.decline'), type: 'button', class: 'rbutton rbutton--danger',
                                 data: { action: 'bots-split-modal#keep', bots_split_modal_id_param: bot.id } %>
                </div>
                <p class="text-inactive" data-split-kept hidden><%= t('bot.split.kept') %></p>
              <% end %>
            <% end %>
          <% end %>
          <% assets = @split.assets %>
          <% stack_class = case assets.size
                           when 0, 1 then ''
                           when 2 then 'ticker-group--2'
                           else 'ticker-group--many'
                           end %>
          <p><%= t('bot.split.explanation') %></p>
          <div class="merge-modal__stack mb-3">
            <div class="ticker-group ticker-group--fold <%= stack_class %>" data-controller="ticker-fold">
              <% assets.each do |asset| %>
                <%= tag.div asset.symbol, class: ticker_class(asset),
                            style: "background: #{ensure_contrast(asset.color || '#8A9BA8')}", data: ticker_data(asset) %>
              <% end %>
            </div>
          </div>
          <div class="buttons buttons--row--2">
            <%= button_tag type: 'button', class: 'button button--outline button--large', data: { action: 'modal--base#animateOutCloseAndCleanUp' } do %>
              <%= t('button.cancel') %>
            <% end %>
            <%= button_to t('button.split'), bots_split_path, method: :post,
                          params: { ids: @split.bots.map(&:id) },
                          class: 'button button--sky button--large',
                          form: { data: { bots_merge_form: true, bots_split_modal_target: 'form' } } %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>
<% end %>
