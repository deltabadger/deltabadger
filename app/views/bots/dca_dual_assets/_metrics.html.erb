<% hide_money = hide_balances?(bot) %>
<% quote = bot.quote_asset&.symbol %>
<div id="metrics" style="display: flex; flex-direction: column; gap: 1rem;">
  <% if metrics[:prices_stale] %>
    <p class="status-button__hint" role="status">
      <%= t('bot.details.stats.exchange_unavailable_html') %>
    </p>
  <% end %>
  <%# Invested and portfolio value are both money and nothing else lives in this panel, so hiding
      balances takes the whole grid rather than emptying it. %>
  <% unless hide_money %>
    <div class="widget data-grid data-grid--two-columns">
      <%= render partial: "bots/metrics_item", locals: {
        label: t('data_labels.invested'),
        value: quoted_figure(format_value(metrics[:total_quote_amount_invested], max_decimals: bot.decimals[:quote] || 8), quote),
        loading: false
      } %>
      <%= render partial: "bots/metrics_item", locals: {
        label: t('data_labels.portfolio_value'),
        value: quoted_figure(format_value(metrics[:total_amount_value_in_quote], max_decimals: bot.decimals[:quote] || 8), quote),
        loading: loading
      } %>
    </div>
  <% end %>

  <%# Both legs are the same row with a different prefix. No investment yet means no rows — the
      table renders its own placeholder. %>
  <% rows = if metrics[:total_quote_amount_invested].positive?
              %w[base0 base1].filter_map do |leg|
                asset = bot.public_send("#{leg}_asset")
                next unless asset

                { asset: asset, symbol: asset.symbol,
                  amount: metrics[:"total_#{leg}_amount"].round(bot.decimals[leg.to_sym] || 8),
                  avg_price: metrics[:"#{leg}_average_buy_price"]&.round(bot.decimals[:"#{leg}_price"] || 8),
                  value: format_value(metrics[:"total_#{leg}_amount_value_in_quote"], max_decimals: bot.decimals[:quote] || 8),
                  pnl: metrics[:"#{leg}_pnl"] }
              end
            else
              []
            end %>
  <div id="assets_metrics_table" class="widget widget--table">
    <%= render 'bots/assets_table', rows: rows, body_id: 'assets_metrics_list', loading: loading, hide_money: hide_money,
               quote: quote %>
  </div>
</div>
