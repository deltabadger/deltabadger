<%# Same shape as the other trigger infos (_indicator_limit_info, _price_drop_limit_info): a
    `small-info` block under the sentence — that class is what makes it a full-width line rather
    than flowing into the sentence — rendered only while the rule is active, going green when the
    trigger's criteria are currently met.

    The drift readout is also the only place a below-minimum rebalance is visible: those are
    deliberately silent, since they repeat every poll for as long as the drift lasts. %>
<% if bot.id.present? && bot.rebalance_enabled? %>
  <small id="<%= bot.new_record? ? "new-settings-rebalance-info" : "settings-rebalance-info" %>" class="small-info">
    <% if bot.rebalance_ambiguous? %>
      <div class="text-error">
        <%= t("bot.settings.rebalance.paused") %>
        <%# A link, not button_to: this renders INSIDE the settings form_with, and button_to's nested
            <form> would be dropped by the browser, leaving the button wired to the settings route. %>
        <%= link_to t("bot.settings.rebalance.resume"),
                    bot_rebalance_resolutions_path(bot_id: bot.id),
                    data: { turbo_method: :post,
                            turbo_confirm: t("bot.settings.rebalance.resume_confirm") } %>
      </div>
    <% else %>
      <% drift = bot.rebalance_drift %>
      <% if drift.present? %>
        <div class="<%= drift > bot.rebalance_threshold ? "text-success" : "" %>">
          <%= t("bot.settings.rebalance.drift", drift: (drift * 100).round(1)) %>
        </div>
      <% end %>
    <% end %>
    <div><%= t("bot.settings.rebalance.note") %></div>
  </small>
<% end %>
