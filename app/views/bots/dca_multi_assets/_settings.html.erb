<% path = bot_path(bot) %>
<% method = :patch %>

<div id="settings" class="column gap-1">
  <%= render partial: "bots/dca_multi_assets/settings/main", locals: { bot: bot, method: method, path: path } %>
  <%# Only where every member has a market cap to be weighted by — or where the rule is already on,
      so a basket whose data went away can still switch it off. Never for one asset, which weighs 100%
      by any rule; a stored rule is kept and applies again once the basket grows. %>
  <% if !bot.one_asset? && (bot.market_cap_weightable? || bot.market_cap_weighted?) %>
    <%= render partial: "bots/dca_multi_assets/settings/marketcap_allocation", locals: { bot: bot, method: method, path: path } %>
  <% end %>
  <%# Smart Intervals splits a buy; a basket sells for a fixed quote amount, which it has no split for. %>
  <% unless bot.sells_quote_amount? %>
    <%= render partial: "bots/settings/smart_intervals", locals: { bot: bot, method: method, path: path } %>
  <% end %>
  <%= render partial: "bots/settings/limit_orders", locals: { bot: bot, method: method, path: path } %>
  <%= render partial: "bots/settings/starting_time", locals: { bot: bot, method: method, path: path } %>
  <%# Shared with the single-asset bot. Each condition names the basket member it watches through
      its own <prefix>_in_ticker_id select, which base_select_options scopes to the composition. %>
  <%= render partial: "bots/settings/price_limit", locals: { bot: bot, method: method, path: path } %>
  <%= render partial: "bots/settings/price_drop_limit", locals: { bot: bot, method: method, path: path } %>
  <%= render partial: "bots/settings/moving_average_limit", locals: { bot: bot, method: method, path: path } %>
  <%= render partial: "bots/settings/indicator_limit", locals: { bot: bot, method: method, path: path } %>
  <%# The cap bounds buying. The pair bot's sell-side cap counts base, which a basket has no single one of. %>
  <% unless bot.selling? %>
    <%= render partial: "bots/settings/amount_limit", locals: { bot: bot, method: method, path: path } %>
  <% end %>
  <%# Threshold rebalancing stands down while selling (Bot::Rebalanceable#rebalance_due?), and one asset
      has nothing to drift from, so it is offered in neither case — the setting is kept and comes back
      with buying, or with a second asset. A halted swap's Resume is in the metrics panel, so nothing
      here is needed to resolve one. %>
  <% unless bot.selling? || bot.one_asset? %>
    <%= render partial: "bots/settings/rebalance", locals: { bot: bot, method: method, path: path } %>
  <% end %>
</div>
