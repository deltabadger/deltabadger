<%= render 'layouts/modal/full_page' do %>
  <div class="bot-creation-layout">
    <%= render partial: 'bots/dca_multi_assets/new_step_progress_bar', locals: { current_step: :spendable } %>

    <%= render "bots/wizard/sentence", bot: @bot, current_step: :spendable %>

    <%= turbo_frame_tag "asset-picker",
                        data: { action: "keydown@window->arrow-keys-navigation#navigate", controller: "arrow-keys-navigation scroll-state" },
                        class: "modal--search__assets selectable-options vt-step-body" do %>
      <%= form_with model: @bot, url: bots_dca_multi_assets_pick_spendable_asset_path, method: :post do %>
        <% @assets.each do |id, symbol, name, color, category, image_url, exchanges| %>
          <%= render partial: "bots/asset_search_result",
                     locals: { bot: @bot, asset_field: :quote_asset_id, id:, symbol:, name:, color:, category:, image_url:, exchanges: } %>
        <% end %>
        <%= turbo_frame_tag @next_page_frame_id, src: @next_page_url, loading: :lazy if @next_page_url %>
      <% end %>
    <% end %>
  </div>
<% end %>
