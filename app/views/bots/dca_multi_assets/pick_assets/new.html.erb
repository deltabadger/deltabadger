<%= render 'layouts/modal/full_page' do %>
  <div class="bot-creation-layout">
    <%= render partial: 'bots/dca_multi_assets/new_step_progress_bar', locals: { current_step: :assets } %>

    <%= render "bots/wizard/sentence", bot: @bot, current_step: :assets %>

    <div class="wizard-assets vt-step-body">
      <div class="wizard-assets__list">
        <% @chosen.each do |asset| %>
          <div class="wizard-assets__row">
            <div class="modal--search__cell">
              <%= tag.div asset.symbol, class: ticker_class(asset), style: "background: #{ensure_contrast(asset.color || '#8A9BA8')}", data: ticker_data(asset) %>
            </div>
            <div class="modal--search__cell"><%= asset.name %></div>
            <div class="modal--search__cell wizard-assets__action">
              <%= button_to '×', remove_bots_dca_multi_assets_pick_assets_path,
                            params: { bots_dca_multi_asset: { base_asset_id: asset.id } },
                            class: 'rbutton rbutton--small',
                            form: { data: { turbo_frame: 'modal_content' } },
                            title: t('bot.dca_multi_asset.remove_asset') %>
            </div>
          </div>
        <% end %>
      </div>

      <% no_common_exchange = @chosen.any? && @eligible_exchanges.empty? %>
      <% if no_common_exchange %>
        <p class="wizard-assets__warning" role="alert"><%= t('bot.dca_multi_asset.no_common_exchange') %></p>
      <% end %>

      <% if @chosen.size >= Bots::DcaMultiAsset::MAX_ASSETS %>
        <p class="text-inactive"><%= t('bot.dca_multi_asset.max_assets_reached', max: Bots::DcaMultiAsset::MAX_ASSETS) %></p>
      <% else %>
        <%= form_with url: new_bots_dca_multi_assets_pick_assets_path, method: :get,
                      data: { controller: 'form--submit-after-delay', turbo_frame: 'asset-picker' },
                      class: 'modal--search' do |f| %>
          <%= f.text_field :query, autocomplete: 'off', placeholder: t('bot.dca_multi_asset.add_another_asset'),
                           data: { action: 'input->form--submit-after-delay#submit' },
                           class: 'modal--search__input' %>
        <% end %>
        <%= turbo_frame_tag 'asset-picker',
                            data: { action: 'keydown@window->arrow-keys-navigation#navigate', controller: 'arrow-keys-navigation scroll-state' },
                            class: 'modal--search__assets selectable-options' do %>
          <%= form_with model: @bot, url: bots_dca_multi_assets_pick_assets_path, method: :post do %>
            <% @assets.each do |id, symbol, name, color, category, exchanges| %>
              <%= render partial: 'bots/asset_search_result',
                         locals: { bot: @bot, asset_field: :base_asset_id, id:, symbol:, name:, color:, category:, exchanges: } %>
            <% end %>
            <%= turbo_frame_tag @next_page_frame_id, src: @next_page_url, loading: :lazy if @next_page_url %>
          <% end %>
        <% end %>
      <% end %>

      <%= button_to t('button.next'), advance_bots_dca_multi_assets_pick_assets_path,
                    class: 'button button--success button--large',
                    disabled: @chosen.size < Bots::DcaMultiAsset::MIN_ASSETS || no_common_exchange,
                    form: { data: { turbo_frame: 'modal_content' } } %>
    </div>
  </div>
<% end %>
