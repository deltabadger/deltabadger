<%# `param_name` and `trading` default to the bot wizard's shape: a bot-scoped field, and venues
    whose order placement is unavailable shown disabled. Read-only pickers (the tracker) pass their
    own field name and `trading: false` — nothing is placed there, so nothing is out of reach. %>
<% param_name = local_assigns.fetch(:param_name) { "#{local_assigns[:bot].model_name.param_key}[exchange_id]" } %>
<% trading = local_assigns.fetch(:trading, true) %>
<%= turbo_frame_tag "exchange-picker", data: { action: "keydown@window->arrow-keys-navigation#navigate", controller: "arrow-keys-navigation" }, class: "selectable-options" do %>
  <%= form_with url: submit_url, method: :post do |f| %>
    <div class="exchange-grid">
      <% exchanges.each do |exchange| %>
        <% unavailable = trading && !exchange.order_placement_available? %>
        <div class="exchange-grid__option">
          <%= button_tag name: param_name,
                         value: exchange.id, type: :submit,
                         class: "exchange-grid__item",
                         disabled: unavailable,
                         data: { arrow_keys_navigation_target: "item button", turbo_frame: "modal_content" } do %>
            <%= render "svg/exchanges/#{exchange.name_id}" %>
          <% end %>
          <% if unavailable %>
            <p class="exchange-grid__unavailable-note"><%= t('bot.hyperliquid_trading_unavailable') %></p>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
