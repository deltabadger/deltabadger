<%# draggable="false" on the link is load-bearing: an anchor is implicitly draggable, so without it
    the browser drags the link out of the page instead of picking the tile up. Clicking through to
    the bot is unaffected — a completed drag fires no click. %>
<%# What the dashboard's Merge needs to know about this tile, on the root because nothing ever replaces
    the root: whether it can be picked, what it spends, whether it has orders resting on its venue, and
    its members as the chips the merge bar shows — each chip naming the venues that list it at this
    quote, so the bar can tell whether one venue lists everything picked. Computed once per page in
    BotsController#index; the fallback keeps the partial renderable on its own. %>
<% mergeable = local_assigns.key?(:mergeable_ids) ? mergeable_ids.include?(bot.id) : Bot::Merge.mergeable?(bot) %>
<div class="widget bot-tile" id="<%= dom_id(bot, :tile) %>" data-bot-id="<%= bot.id %>" draggable="true"
     data-merge-ok="<%= mergeable %>" data-merge-exchange="<%= bot.exchange_id %>"
     data-merge-quote="<%= bot.try(:quote_asset_id) %>" data-merge-quote-symbol="<%= bot.try(:quote_asset)&.symbol %>"
     data-merge-open-orders="<%= mergeable && bot.transactions.waiting.exists? %>">
  <% if mergeable %>
    <% members = Bot::Merge.members(bot) %>
    <% venues = Bot::Merge.venues_for(members.map(&:id), bot.quote_asset_id) %>
    <template data-merge-chips>
      <% members.each do |asset| %>
        <%= tag.div asset.symbol, class: ticker_class(asset),
                    style: "background: #{ensure_contrast(asset.color || '#8A9BA8')}",
                    data: ticker_data(asset).merge(exchanges: Array(venues[asset.id]).join(',')) %>
      <% end %>
    </template>
  <% end %>
  <%= link_to bot_path(bot), draggable: "false" do %>
    <div class="bot-tile__header">
      <div class="bot-tile__hgroup">
        <div class="bot-tile__title">
          <% if bot.dca_single_asset? && bot.quote_asset_id.present? && bot.base_asset_id.present? %>
            <span><%= bot.base_asset.symbol %></span>
          <% elsif bot.dca_index? && bot.quote_asset_id.present? && bot.num_coins.present? %>
            <span><%= bot.display_index_name %></span>
          <% elsif bot.dca_multi_asset? && bot.quote_asset_id.present? %>
            <% symbols = bot.base_assets.map(&:symbol) %>
            <% if symbols.size >= 3 %>
              <%# Three symbols while they fit on one line, two otherwise. %>
              <span data-controller="title-fit">
                <span><%= symbols.first(3).join(', ') %><%= " +#{symbols.size - 3}" if symbols.size > 3 %></span>
                <span hidden><%= symbols.first(2).join(', ') %> +<%= symbols.size - 2 %></span>
              </span>
            <% else %>
              <span><%= symbols.join(', ') %></span>
            <% end %>
          <% elsif bot.signal? && bot.quote_asset_id.present? && bot.base_asset_id.present? %>
            <span><%= bot.base_asset.symbol %></span>
          <% end %>
          <% if bot.exchange.present? %>
            <%= render "svg/exchange-#{bot.exchange.name_id}", title: bot.exchange.name %>
          <% end %>
        </div>
      </div>
      <% if bot.dca_single_asset? || bot.dca_index? || bot.dca_multi_asset? || bot.signal? %>
        <%= render "bots/bot_tile/bot_tile_pnl", bot: bot, loading: loading_hash[bot.id], pnl: pnl_hash[bot.id],
                   profit_usd: profit_usd_hash[bot.id], denomination: denomination %>
      <% end %>
    </div>
    <div class="bot-tile__subtitle">
      <%= bot.label %>
    </div>
  <% end %>
  <div class="bot-control">
    <%= render "bots/status/status_bar", bot: bot %>
    <%= render "bots/status/status_button", bot: bot %>
  </div>
</div>
