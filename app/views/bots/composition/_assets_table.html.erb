<%# locals: (values:, logo_assets:, body_id: nil, bot: nil, sellable: false, hide_money: false, quote: nil, locks: {}, selling: false) %>
<%# Composition holdings come from the metrics hash, not from the bot's own columns, so they need
    mapping onto the shared table's rows. `logo_assets` is key => Asset. `sellable` is a Hash
    key => asset id for the rows that may carry Sell (or false for none): direct indexing is the freedom
    to close one position on its own, but a dust remainder the venue cannot sell must not get a button
    that 404s. `locks` (symbol =>
    { days_left:, until: }) marks a constituent inside a wash-sale window: the row shows the
    countdown, and keeps Sell if a remainder is still sellable.

    Green marks the tax-clean moment — a position under water on this bot's OWN lots, whose sale
    realises a loss. An estimate (Bot::TaxLots), and it moves with the price. %>
<% sellable = local_assigns.fetch(:sellable, false) || {} %>
<% locks = local_assigns.fetch(:locks, {}) %>
<%# A sale is already running, so no row's Sell can be placed — the refusal is bot-wide, not per
    symbol. The button is replaced in place rather than removed: a row that simply loses its button
    says nothing about why, and the whole column would resize as the last one went. Only rows that
    HAD a button get the placeholder; dust and nothing-held rows have no box to reserve. %>
<% selling = local_assigns.fetch(:selling, false) %>
<%= render 'bots/assets_table', body_id: body_id, actions: sellable.present? || locks.present?,
           hide_money: local_assigns.fetch(:hide_money, false), quote: local_assigns[:quote],
           rows: values.map { |symbol, data|
      lock = locks[symbol]
      harvest = data[:harvestable]
      { asset: logo_assets[symbol], symbol: symbol,
        amount: number_with_precision(data[:amount] || 0, precision: 6, strip_insignificant_zeros: true),
        avg_price: data[:avg_price] && money_figure(data[:avg_price]),
        value: data[:current_value] && money_figure(data[:current_value]),
        pnl: data[:pnl_percentage],
        action: safe_join([
          (lock ? tag.span(t('bot.liquidation.locked', days: lock[:days_left]), class: 'text-inactive', title: l(lock[:until].to_date)) : nil),
          (lock && lock[:source] == 'ledger' ? tag.span(t('bot.wash_sale.from_ledger'), class: 'text-inactive') : nil),
          (if !sellable[symbol]
             nil
           elsif selling
             selling_placeholder(t('bot.liquidation.sell'))
           else
             link_to(t('bot.liquidation.sell'),
                     new_bot_liquidation_path(bot_id: bot.id, symbol: symbol, asset_id: sellable[symbol]),
                     class: "rbutton rbutton--small #{'rbutton--success' if harvest}",
                     title: (harvest ? t('bot.liquidation.harvest_hint') : nil),
                     data: { turbo_frame: 'modal' })
           end)
        ].compact, ' ') }
    } %>
