<% exited = bot.exited_holdings(metrics) %>
<%# A failed live price read empties asset_values, and the wash-sale rows must survive that: a
    constituent the bot sold in full is exactly the one with no ledger row and a window to serve. %>
<% asset_values = metrics[:asset_values] || {} %>
<% locked = bot.locked_members %>
<% key_assets = metrics[:key_assets] || {} %>
<% locked_symbols = locked.map { |member| key_assets.key(member[:asset_id]) || member[:symbol] } %>
<% realised = metrics[:realised_pnl].to_d %>
<% hide_money = hide_balances?(bot) %>
<% quote = bot.quote_asset&.symbol %>
<div id="metrics" style="display: flex; flex-direction: column; gap: 1rem;">
  <% if metrics[:prices_stale] %>
    <p class="status-button__hint" role="status">
      <%= t('bot.details.stats.exchange_unavailable_html') %>
    </p>
  <% end %>
  <%# Invested, portfolio value and realised P/L are all money and nothing else lives in this
      panel, so hiding balances takes the whole grid rather than emptying it. %>
  <% unless hide_money %>
    <%# Two columns until there is a third figure to show. Realised P/L only exists once the user has
        liquidated something, and an empty third cell on every other bot is worse than the grid's own
        responsive columns. %>
    <div class="widget data-grid <%= 'data-grid--two-columns' if realised.zero? %>">
      <div class="data-grid__item" data-controller="tooltip">
        <div class="label"><%= t('bot.details.stats.total_invested') %></div>
        <div class="data-grid__item__value">
          <% if loading %>
            <span class="loading-placeholder">...</span>
          <% else %>
            <%= quoted_figure(money_figure(metrics[:total_quote_amount_invested]), quote) %>
          <% end %>
        </div>
      </div>
      <div class="data-grid__item" data-controller="tooltip">
        <div class="label"><%= t('bot.details.stats.portfolio_value') %></div>
        <div class="data-grid__item__value">
          <% if loading %>
            <span class="loading-placeholder">...</span>
          <% else %>
            <%= quoted_figure(money_figure(metrics[:total_amount_value_in_quote]), quote) %>
          <% end %>
        </div>
      </div>
      <% unless realised.zero? %>
        <%# The note is what "realised" does NOT mean here — a footnote rather than a second label,
            which is what it read as while it was a line of small print under the figure.

            Wired exactly like the two items beside it: the controller on the ITEM, so the bubble is
            positioned by the grid's own rule and opens UPWARD. Hung off the icon instead it opened
            downward, outside .widget — which sets overflow: hidden, so it was clipped to nothing. %>
        <div class="data-grid__item" data-controller="tooltip">
          <div class="label label--info">
            <%= t('bot.dca_index.realised_pnl') %>
            <span class="tooltip-info-icon"
                  data-action="mouseenter->tooltip#showTooltip mouseleave->tooltip#hideTooltip click->tooltip#toggle">
              <%= render 'svg/24x24_info' %>
            </span>
          </div>
          <div class="data-grid__item__value <%= realised.negative? ? 'text-danger' : 'text-success' %>">
            <% if loading %>
              <span class="loading-placeholder">...</span>
            <% else %>
              <%= realised.negative? ? '' : '+' %><%= quoted_figure(number_with_precision(realised, precision: 2, delimiter: ','), quote) %>
            <% end %>
          </div>
          <%= tag.div t('bot.dca_index.realised_pnl_note'), class: 'tooltip tooltip--note' %>
        </div>
      <% end %>
    </div>
  <% end %>

  <% exited_symbols = exited.map { |holding| holding[:symbol] }.to_set %>
  <%# Each holding's asset, by the id its orders recorded — current bot_index_assets rows cannot identify
      holdings that exited after a rotation. %>
  <% logo_assets = bot.holding_assets(metrics) %>
  <%# MEMBERS, listed because the composition wants them — not "whatever is left after removing the
      quitters". Those two agreed only while every held asset was one or the other, and they stopped
      agreeing once a quitter too small to sell was ruled out of its own table: defined by
      subtraction, it fell through into this one and was rendered as a constituent of the index.
      A member is shown at any size, because the bot is going to keep buying it.

      An empty composition means the first derivation has not landed. Same reasoning as
      Liquidatable#exited_holdings: we do not know the membership, so nothing is claimed about it and
      every holding is shown rather than none. %>
  <%# Any position can be closed on its own, so Sell sits on every sellable row of both tables — a
      dust remainder the venue cannot sell gets none. A halted liquidation blocks the lot until it
      is resolved, and an archived or deleted bot cannot trade at all. %>
  <% may_sell = !bot.liquidation_halted? && !bot.archived? && !bot.deleted? %>
  <%# key => asset id: the Sell link names the asset it showed, so a key that comes to mean another asset
      between the render and the click sells nothing. %>
  <% sellable = may_sell ? bot.sellable_holdings(metrics).to_h { |h| [h[:symbol], h[:asset_id]] } : {} %>
  <%# A sale is already under way, so every Sell on this bot would be refused — the block is
      bot-wide, not per symbol. Gated on may_sell so a HALT never renders as "selling": a halt means
      nobody knows what happened, which is the opposite of progress, and it has its own Clear to
      offer instead. %>
  <% selling = may_sell && bot.liquidation_selling? %>
  <% if asset_values.present? %>
    <% in_index = bot.bot_index_assets.in_index.pluck(:asset_id).to_set %>
    <%# A holding known only by its symbol string (recorded before orders stored their asset) is listed
        with the members and never offered for sale. %>
    <% composition_values = if in_index.empty?
                              asset_values.reject { |symbol, _| exited_symbols.include?(symbol) }
                            else
                              asset_values.select { |symbol, _| key_assets[symbol].nil? || in_index.include?(key_assets[symbol]) }
                            end %>
    <%# A locked name is listed once, in its own table below. %>
    <% composition_values = composition_values.except(*locked_symbols) %>
    <% if composition_values.present? %>
      <div id="assets_metrics_table" class="widget widget--table" data-controller="table-fit">
        <%= render 'bots/composition/assets_table', values: composition_values, logo_assets: logo_assets,
                   body_id: 'assets_metrics_list', bot: bot, sellable: sellable,
                   hide_money: hide_money, quote: quote, selling: selling %>
      </div>
    <% end %>
  <% end %>

  <%# NOT nested under asset_values: a failed live price read empties that hash, and it is exactly
      the network trouble that produces an unresolved placement in the first place. The Clear action
      has to survive it — resolving an untracked order needs no prices at all. %>
  <% if exited.any? || bot.liquidation_halted? %>
    <%# A locked quitter is listed once, in its own table below. %>
    <% exited_values = exited.index_by { |holding| holding[:symbol] }.except(*locked_symbols) %>
    <div id="exited_metrics_table" class="widget widget--table" data-controller="table-fit">
      <div class="exited-header">
        <span class="label"><%= t(exited_title_key) %></span>
        <%# if/elsif, so the halt and the batch action can never render side by side: one of them
            says "do not trade this bot" and the other offers to. %>
        <% halt = bot.liquidation_halt %>
        <% if halt[:bases].any? %>
          <%# A halted liquidation is the one thing that must not be re-run: the outcome of the last
              placement is unknown, so selling again could sell assets that are already gone.
              Named, because a sale can cover several positions and "Sale unconfirmed" alone would
              point at all of them. The names cover both halves: a placement with no row to point
              at, and orders the venue stopped reporting. %>
          <span class="text-error">
            <%= "#{t('bot.liquidation.halted')} · #{halt[:bases].join(', ')}" %>
          </span>
          <%# The order ids ride along, so the attestation covers exactly the rows listed here —
              anything given up on after this render keeps blocking instead of being cleared by an
              answer that was never about it.

              The nonce goes only with an AMBIGUOUS intent, which is the only kind the text above
              names. A `placing` one is not shown — its placement may still be running — so sending
              its nonce would let this answer clear a sale the user was never asked about, if it
              turned ambiguous between this render and the job.

              Names and ids come from ONE snapshot: asked separately they can disagree, and a row
              given up on between the two reads would be submitted here without appearing above. %>
          <%= button_to t('bot.liquidation.resolve'),
                        bot_liquidation_resolutions_path(bot_id: bot.id, intent_id: halt[:intent_id],
                                                         order_ids: halt[:order_ids]),
                        class: 'rbutton rbutton--danger',
                        form: { data: { turbo_confirm: t('bot.liquidation.resolve_confirm') } } %>
        <%# The batch this band started is still running. Same treatment as the rows: the button's
            own box, emptied, with the spinner over it — and still gated on .many?, so a single
            quitter does not gain a "Sell all" placeholder for a button it never had. %>
        <% elsif selling && exited_values.many? %>
          <%= selling_placeholder(t('bot.liquidation.sell_all')) %>
        <%# The list is built FROM the rows this table renders, so the button can never name a
            position the page is not showing — members, dust and wash-sale names are already out.
            A link into the confirmation, never a form that places from here.

            may_sell as well as the branch above: that one covers the halt, but archived and deleted
            are exactly what gates the row Sells. .many?, because over a single row this would be
            that row's own Sell, twice, on a money path. %>
        <% elsif may_sell && exited_values.many? %>
          <%= link_to t('bot.liquidation.sell_all'),
                      new_bot_liquidation_path(bot_id: bot.id, symbol: exited_values.keys,
                                               asset_id: exited_values.values.map { |holding| holding[:asset_id] }),
                      class: 'rbutton rbutton--small rbutton--danger', data: { turbo_frame: 'modal' } %>
        <% end %>
      </div>
      <% if exited_values.any? %>
        <%# Sell sits on each row, not over the table: every one of these is a separate taxable
            disposal, so the user closes them one at a time and always sees which. %>
        <%= render 'bots/composition/assets_table',
                   values: exited_values,
                   logo_assets: logo_assets, body_id: 'exited_metrics_list', bot: bot,
                   hide_money: hide_money, quote: quote, sellable: sellable, selling: selling %>
      <% end %>
    </div>
  <% end %>

  <%= render 'bots/composition/locked_table', bot: bot, members: locked, values: asset_values, key_assets: key_assets,
             sellable: sellable, hide_money: hide_money, quote: quote, selling: selling %>

  <%# The proceeds of a sale, waiting to go back into the basket. The amount IS the display: realised
      cash has no line of its own anywhere else, and it would otherwise sit inside portfolio value
      while the DCA leg drained it a contribution at a time.

      LAST in the panel, under the quitters table rather than over the figures. The money it offers
      comes from selling the rows in that table, so above them it asks about proceeds the reader has
      not been shown the source of yet — and it pushed the two tables down to make room for a
      question about them.

      Hidden whenever the answer would be refused — a halt, a rebalance mid-swap, a liquidation still
      working, this leg's own batch — rather than offering an action the job will decline. "No" is
      guarded server-side as well: hiding a button does not stop a stale tab. %>
  <%# A halted rebalance swap blocks every tick, sells included, until the user resolves it. Its own
      widget, outside every balance, price and direction condition: the settings rule it used to live
      in is hidden while a basket sells, and a user can switch the rule off mid-halt. %>
  <% if bot.respond_to?(:rebalance_ambiguous?) && bot.rebalance_ambiguous? %>
    <div class="widget redeploy-prompt">
      <span class="text-error"><%= t('bot.settings.rebalance.paused') %></span>
      <%= button_to t('bot.settings.rebalance.resume'),
                    bot_rebalance_resolutions_path(bot_id: bot.id),
                    class: 'rbutton rbutton--danger',
                    form: { data: { turbo_confirm: t('bot.settings.rebalance.resume_confirm') } } %>
    </div>
  <% end %>
  <% if bot.redeploy_ambiguous? %>
    <div class="widget redeploy-prompt">
      <span class="text-error"><%= t('bot.redeploy.halted') %></span>
      <%= button_to t('bot.redeploy.resolve'),
                    bot_redeploy_resolutions_path(bot_id: bot.id, intent_id: bot.redeploy_pending[:id]),
                    class: 'rbutton rbutton--danger',
                    form: { data: { turbo_confirm: t('bot.redeploy.resolve_confirm') } } %>
    </div>
  <%# Not while selling: buying the proceeds back is the opposite of what a selling basket is doing. %>
  <% elsif !hide_money && !bot.archived? && !bot.deleted? && !bot.selling? &&
           !bot.redeploy_in_flight? && !bot.rebalance_pending? && !bot.liquidation_in_flight? %>
    <% offer = bot.redeploy_offer(metrics) %>
    <% if offer.positive? %>
      <div class="widget redeploy-prompt">
        <span class="label">
          <%= t('bot.redeploy.prompt',
                amount: number_with_precision(offer, precision: 2, delimiter: ','),
                symbol: bot.quote_asset&.symbol) %>
        </span>
        <div class="redeploy-prompt__actions">
          <%= button_to t('bot.redeploy.confirm'), bot_redeploy_path(bot_id: bot.id),
                        class: 'rbutton rbutton--success' %>
          <%= button_to t('bot.redeploy.decline'), bot_redeploy_path(bot_id: bot.id),
                        method: :delete, class: 'rbutton rbutton--danger' %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
