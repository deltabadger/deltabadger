<%= turbo_stream.replace 'settings', partial: "#{@bot.model_name.collection}/settings", locals: { bot: @bot } %>
<%= turbo_stream.replace dom_id(@bot, :status_button), partial: 'bots/status/status_button', locals: { bot: @bot } %>
<%# The metrics panel carries the Redeploy prompt, which a basket offers only while buying. %>
<% if @bot.respond_to?(:redeploy_offer) %>
  <%= turbo_stream.replace 'metrics', partial: @bot.metrics_partial,
                           locals: { bot: @bot, metrics: @bot.metrics_with_current_prices_from_cache || @bot.metrics,
                                     loading: false, exited_title_key: @bot.exited_title_key } %>
<% end %>

<%= turbo_stream_prepend_flash %>
<%= wash_sale_prompt_stream(@bot) %>
