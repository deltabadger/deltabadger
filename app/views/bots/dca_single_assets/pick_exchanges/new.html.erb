<%= render 'layouts/modal/full_page', **(params[:auto_open] ? { close_url: "" } : {}) do %>
  <div class="bot-creation-layout">
    <%= render partial: 'bots/dca_single_assets/new_step_progress_bar', locals: { current_step: :exchange } %>

    <%= render "bots/wizard/sentence", bot: @bot, current_step: :exchange %>

    <div class="vt-step-body">
      <%= render "bots/pick_exchanges/table",
        bot: @bot,
        exchanges: @exchanges,
        submit_url: bots_dca_single_assets_pick_exchange_path %>
      <%= render 'bots/wizard/stock_activation_notice', bot: @bot %>
    </div>
  </div>
<% end %>
