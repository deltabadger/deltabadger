<%= turbo_stream_from "user_#{current_user.id}", :bot_updates %>

<%# Not @bots.empty?: a user whose bots are all archived still has bots, and needs the filter row. %>
<% if @total_bots.zero? && !@has_archived %>
  <% if @auto_open_dca %>
    <% content_for :modal_src, new_bots_dca_single_assets_pick_buyable_asset_path(auto_open: true) %>
    <% content_for :hide_chrome, true %>
  <% end %>
  <%= render partial: 'bots/new_menu_start' %>
<% else %>
  <%# The total is asked for ONCE per page load, and asked again only while its spinner is still
      there — a lost request, a failed job or a broadcast that landed during a disconnect. The
      per-bot tile jobs no longer broadcast it as a side effect. %>
  <%= tag.section class: 'dash-intro', data: @global_pnl_loading ? { controller: "broadcast--on-connect",
                                                                     broadcast__on_connect_method_value: "global_pnl_update",
                                                                     broadcast__on_connect_retry_while_value: "#global-pnl .loader--small" } : {} do %>
    <%= render partial: 'bots/global_pnl', locals: { global_pnl: @global_pnl, loading: @global_pnl_loading } %>
  <% end %>
  
  <div class="page-head page-head--bots">
    <div class="filters">
      <%# Fluid: "All" and "Inactive" are nowhere near the same width, so equal columns would
          pad the short label out of proportion. %>
      <% if @show_filters %>
        <%= render 'shared/segmented', fluid: true, label: t('bot_filters.all'),
                   options: (%w[all active inactive] + (@has_archived ? %w[archived] : [])).map { |filter|
                     { value: filter, label: t("bot_filters.#{filter}"),
                       href: bots_path(filter: filter), active: @filter == filter }
                   } %>
      <% end %>
    </div>

    <div>
      <%= button_to new_bot_path, method: :get, class: "sbutton sbutton--sky", data: { turbo_frame: "modal" }, aria: { label: t('bot.new') } do %>
        <span class="d-none d-sm-inline"><%= t('bot.new') %></span>
        <%= render partial: 'svg/24x24_plus' %>
      <% end %>
    </div>
  </div>

  <%= tag.div class: 'itiles', data: @tile_refresh_ids.any? ? { controller: "broadcast--on-connect",
                                                               broadcast__on_connect_method_value: "pnl_update",
                                                               broadcast__on_connect_method_args_value: { bot_ids: @tile_refresh_ids }.to_json } : {} do %>
    <%= render partial: 'bots/bot_tile/bot_tile', collection: @bots, as: :bot,
               locals: { pnl_hash: @pnl_hash, profit_usd_hash: @profit_usd_hash, loading_hash: @loading_hash } %>
  <% end %>
<% end %>
