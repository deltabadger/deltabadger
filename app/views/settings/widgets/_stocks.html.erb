<%= turbo_frame_tag 'stocks_settings', class: 'sitem' do %>
  <% if StockTradingSettings.deltabadger? %>
    <%# Hosted: the catalog comes from the platform; nothing to manage here.
        Trading keys are per-user, entered in the bot-creation key step. %>
    <%= settings_row 'Alpaca', t('settings.stocks.deltabadger_configured', provider_name: AppConfig.market_data_env_provider_name) %>
  <% else %>
    <%# Self-hosted: the hint reflects catalog state (what users actually get in the pickers), not
        the credential — a synced catalog stays on after a disconnect; the credential only keeps
        it refreshing. This credential is the container's catalog-sync key, so it can be rotated
        while connected, and dropped. %>
    <% is_configured = AppConfig.alpaca_configured? %>
    <% stored_mode = AppConfig.get('alpaca_mode') %>
    <% mode = stored_mode == 'paper' ? 'paper' : 'live' %>
    <%# Unsaved on purpose: only the name and the venue id are wanted, for the walkthrough. %>
    <% alpaca = Exchanges::Alpaca.new(name: 'Alpaca') %>
    <% hint = if is_configured then t('settings.stocks.configured', mode: stored_mode&.capitalize || 'Paper')
              elsif StockTradingSettings.active? then t('settings.stocks.not_refreshing')
              end %>
    <%= settings_row 'Alpaca', hint do %>
      <% if is_configured %>
        <%= render 'settings/confirm', label: t('settings.stocks.disconnect'), text: t('settings.index.api_key_confirmation'),
                                       confirm: t('settings.stocks.disconnect'), url: settings_disconnect_stocks_path %>
      <% end %>
    <% end %>

    <%= form_with url: settings_update_stocks_path, method: :patch, class: 'sform sform--stack sform--inset sitem',
                  data: { turbo_frame: 'stocks_settings', controller: 'form--segmented-field',
                          action: 'segmented:change->form--segmented-field#set' } do |f| %>
      <%# A row of its own: segmented measures its room as its parent's width less its siblings. %>
      <%= settings_row 'Mode', class: 'srow--flush' do %>
        <%= render 'shared/segmented', label: 'Mode', options: [
              { value: 'paper', label: t('settings.stocks.mode_paper'), active: mode == 'paper' },
              { value: 'live', label: t('settings.stocks.mode_live'), active: mode == 'live' }
            ] %>
      <% end %>
      <%= f.hidden_field :alpaca_mode, value: mode, data: { 'form--segmented-field-target': 'field' } %>
      <%= f.text_field :alpaca_api_key, autocomplete: 'off', class: 'rinput rinput--outline rinput--text', placeholder: 'API Key', aria: { label: 'API Key' } %>
      <%= f.text_field :alpaca_api_secret, autocomplete: 'off', class: 'rinput rinput--outline rinput--text', placeholder: 'API Secret', aria: { label: 'API Secret' } %>
      <%= f.submit t('button.connect'), class: 'rbutton rbutton--secondary',
                   data: { turbo_stream: true, turbo_submits_with: t('bot.setup.validating') } %>
      <details class="shelp">
        <summary><%= t('bot.setup.how_to_get_keys', exchange: alpaca.name) %></summary>
        <div class="settings__prose"><%= render_api_key_instructions_for(alpaca) %></div>
      </details>
    <% end %>
  <% end %>
<% end %>
