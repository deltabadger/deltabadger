<%= turbo_frame_tag 'rest_settings' do %>
  <h3 class="settings__heading settings__heading--first"><%= t('settings.rest.title') %></h3>
  <p class="settings__intro"><%= t('settings.rest.description') %></p>

  <%# Minted on first visit, but shown only in the response to Regenerate: a page load carries no secret. %>
  <% token = current_user.personal_api_token.token %>
  <% token = SettingsController::REDACTED unless local_assigns[:reveal_token] %>

  <%= settings_row 'URL' do %>
    <%= render 'settings/widgets/copy_tag', value: AppConfig.api_url, id: 'rest_api_url_display' %>
  <% end %>

  <%= settings_row t('settings.rest.token'), class: 'srow--token' do %>
    <%# When revealed, shown in full, not masked: over plain http from another machine there is no
        Clipboard API, and a token that can only be copied is then a token that cannot be had at all. %>
    <%= render 'settings/widgets/copy_tag', value: token %>
    <%= render 'settings/confirm', label: t('settings.rest.regenerate_token'), text: t('settings.rest.regenerate_confirm'),
                                   confirm: t('settings.rest.regenerate_token'), url: settings_regenerate_api_token_path,
                                   method: :post %>
  <% end %>

  <%= settings_row t('settings.rest.docs') do %>
    <%= link_to settings_download_api_docs_path, class: 'rbutton rbutton--secondary', title: t('settings.rest.download_api_docs'),
                data: { turbo: false } do %>deltabadger-api.md<% end %>
  <% end %>
<% end %>
