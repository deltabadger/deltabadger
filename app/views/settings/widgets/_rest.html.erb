<%= turbo_frame_tag "rest_settings" do %>
  <div class="widget widget--settings">
    <h4 class="modal__title"><%= t('settings.rest.title') %></h4>
    <p class="text-center" style="text-wrap: balance"><%= t('settings.rest.description') %></p>

    <% token = current_user.personal_api_token.token %>
    <dl class="settings-kv">
      <dt class="label">URL</dt>
      <dd><%= render 'settings/widgets/copy_tag', value: AppConfig.api_url, id: 'rest_api_url_display' %></dd>

      <dt class="label"><%= t('settings.rest.token') %></dt>
      <dd>
        <%# Shown in full, not masked: over plain http from another machine there is no Clipboard
            API, and a token that can only be copied is then a token that cannot be had at all. %>
        <%= render 'settings/widgets/copy_tag', value: token %>
        <%= button_to t('settings.rest.regenerate_token'), settings_regenerate_api_token_path, method: :post,
                      form: { data: { turbo_frame: 'rest_settings', turbo_confirm: t('settings.rest.regenerate_confirm') } },
                      class: 'sbutton sbutton--outline' %>
      </dd>

      <dt class="label"><%= t('settings.rest.docs') %></dt>
      <dd>
        <%= link_to settings_download_api_docs_path, class: 'tag tag--copy', title: t('settings.rest.download_api_docs'),
                    data: { turbo: false } do %><%= render 'svg/24x24_doc' %>deltabadger-api.md<% end %>
      </dd>
    </dl>
  </div>
<% end %>
