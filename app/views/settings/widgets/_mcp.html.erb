<%= turbo_frame_tag "mcp_settings" do %>
  <div class="widget widget--settings">
    <h4 class="modal__title"><%= t('settings.mcp.title') %></h4>
    <p class="text-center" style="text-wrap: balance"><%= t('settings.mcp.description') %></p>

    <dl class="settings-kv">
      <dt class="label">URL</dt>
      <dd><%= render 'settings/widgets/copy_tag', value: AppConfig.mcp_url, id: 'mcp_url_display' %></dd>
    </dl>

    <%# Paper trading is MCP's alone — the REST endpoints place real orders — so it stays with the
        MCP connection rather than joining the shared tool matrix below. %>
    <%= form_with url: settings_update_mcp_dry_run_path, method: :patch,
                  data: { controller: 'form--submit', turbo_frame: 'mcp_settings' }, class: 'switch-row' do |f| %>
      <%= f.hidden_field :enabled, value: current_user.mcp_dry_run? ? '0' : '1', id: nil %>
      <div>
        <div class="switch-row__title"><%= t('settings.mcp.dry_run_title') %></div>
        <p class="switch-row__hint"><%= t('settings.mcp.dry_run_description') %></p>
      </div>
      <label class="toggle" title="<%= t('settings.mcp.dry_run_label') %>">
        <input type="checkbox" <%= 'checked' if current_user.mcp_dry_run? %> data-action="change->form--submit#submit" />
        <div class="toggle__style"></div>
      </label>
    <% end %>
  </div>
<% end %>
