<%= turbo_frame_tag 'mcp_settings' do %>
  <h3 class="settings__heading settings__heading--first"><%= t('settings.sections.mcp_server') %></h3>
  <p class="settings__intro"><%= t('settings.mcp.description') %></p>

  <%= settings_row 'URL' do %>
    <%= render 'settings/widgets/copy_tag', value: AppConfig.mcp_url, id: 'mcp_url_display' %>
  <% end %>

  <%# Paper trading is MCP's alone — the REST endpoints place real orders — so it stays with the
      MCP connection rather than joining the tool list below. %>
  <% on = current_user.mcp_dry_run? %>
  <%= settings_row t('settings.mcp.dry_run_title'), t('settings.mcp.dry_run_description') do %>
    <%= render 'settings/switch', url: settings_update_mcp_dry_run_path, frame: 'mcp_settings',
                                  state: (on ? :on : :off), enabled: (on ? '0' : '1'), title: t('settings.mcp.dry_run_label') %>
  <% end %>
<% end %>
