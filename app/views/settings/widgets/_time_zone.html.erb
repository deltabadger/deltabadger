<%= turbo_frame_tag 'update_time_zone_form', class: 'sitem' do %>
  <% hint = tag.span(data: { controller: 'clock', clock_time_zone_value: ActiveSupport::TimeZone[current_user.time_zone].tzinfo.identifier }) do %>
    <%= t('settings.language_and_timezone.current_time_is') %>
    <b data-clock-target="timestamp"><%= Time.current.in_time_zone(current_user.time_zone).strftime('%Y-%m-%d %I:%M %p') %></b>
  <% end %>
  <%= settings_row t('settings.sections.time_zone'), hint do %>
    <%= form_with model: current_user, url: settings_update_time_zone_path, method: :patch,
                  data: { controller: 'form--submit', turbo_frame: 'update_time_zone_form' } do |f| %>
      <%= f.select :time_zone, sorted_time_zone_options, { selected: current_user.time_zone },
                   class: 'rinput rinput--outline rinput--select', aria: { label: t('settings.sections.time_zone') },
                   data: { action: 'change->form--submit#submit' } %>
    <% end %>
  <% end %>
<% end %>
