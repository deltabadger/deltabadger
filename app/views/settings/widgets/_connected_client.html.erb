<%# One client, at group level: a switch per group of this surface. ON only when everything the
    user has in the group is granted, PARTIAL while some of it is — never derived from the user's
    set alone, because a grant left behind after a global switch-off must still show, and still be
    removable. %>
<%
  client = ConnectedClient.for(user: current_user, application: application)
  groups, granted, user_enabled = if surface == 'mcp'
                                    [AppConfig::MCP_TOOL_GROUPS, client&.granted_mcp_tools || [], current_user.enabled_mcp_tool_names]
                                  else
                                    [AppConfig::REST_TOOL_GROUPS, client&.granted_rest_tools || [], current_user.enabled_rest_tool_names]
                                  end
%>
<div class="sclient sitem" data-client="<%= application.id %>">
  <%= settings_row application.name, l(application.created_at, format: :short), class: 'srow--client' do %>
    <%= render 'settings/confirm', label: t('settings.mcp.revoke_client'), text: t('settings.mcp.revoke_client_confirm'),
                                   confirm: t('settings.mcp.revoke_client'),
                                   url: settings_revoke_mcp_client_path(application), params: { surface: surface } %>
  <% end %>
  <%# Switches only where the client holds this surface's scope: a grant it could never use is
      not a permission to show. %>
  <% groups = {} unless application.scopes.exists?(surface == 'mcp' ? 'mcp' : 'api') %>
  <% groups.each do |group, tools| %>
    <%
      granted_here = granted & tools
      available = user_enabled & tools
      state = if granted_here.empty? then :off
              elsif (available - granted_here).empty? then :on
              else :partial
              end
    %>
    <%= settings_row t("settings.mcp.tools_#{group}"), class: 'srow--tool', data: { group: group, surface: surface } do %>
      <%= render 'settings/switch', url: settings_update_client_tool_permissions_path(application), frame: 'connected_clients',
                                    fields: { surface: surface, group: group }, state: state,
                                    enabled: (granted_here.any? ? '0' : '1') %>
    <% end %>
  <% end %>
</div>
