<% ibkr_key = current_user.api_keys.joins(:exchange).find_by(exchanges: { type: 'Exchanges::Ibkr' }, key_type: 'trading') %>
<%# Hidden without the data API (no IBKR catalog source on self-hosted) — except for an
    existing connection, which stays visible so it can be managed/disconnected. %>
<% if StockTradingSettings.ibkr_available? || ibkr_key %>
  <%# Stalled is checked before pending — past the deadline the wizard has given up on this
      registration, and a PENDING badge here would contradict it. %>
  <% status = if ibkr_key&.correct? then 'CONNECTED'
              elsif ibkr_key&.activation_stalled? then 'ACTION NEEDED'
              elsif ibkr_key&.pending_activation? then 'PENDING'
              else 'OFF'
              end %>
  <%= settings_row t('settings.ibkr.widget_title'), status, id: 'ibkr_settings' do %>
    <%= link_to(ibkr_key ? t('settings.ibkr.manage') : t('settings.ibkr.connect_cta'),
                settings_ibkr_connect_path, class: 'rbutton rbutton--secondary', data: { turbo_frame: '_top' }) %>
  <% end %>
<% end %>
