<% language_options = [
  ['English', 'en'],
  ['Deutsch', 'de'],
  ['Nederlands', 'nl'],
  ['Français', 'fr'],
  ['Español', 'es'],
  ['Português', 'pt'],
  ['Italiano', 'it'],
  ['Polski', 'pl'],
  ['Русский', 'ru'],
  ['Čeština', 'cs'],
  ['Slovenčina', 'sk'],
  ['Dansk', 'da'],
  ['Svenska', 'sv'],
  ['Ελληνικά', 'el'],
  ['Български', 'bg']
] %>
<%= turbo_frame_tag 'update_locale_form', class: 'sitem' do %>
  <%= settings_row t('settings.sections.language') do %>
    <%= form_with model: current_user, url: settings_update_locale_path, method: :patch,
                  data: { controller: 'form--submit', turbo_frame: 'update_locale_form' } do |f| %>
      <%= f.select :locale, language_options, { selected: current_user.locale || I18n.default_locale.to_s },
                   class: 'rinput rinput--outline rinput--select', aria: { label: t('settings.sections.language') },
                   data: { action: 'change->form--submit#submit' } %>
    <% end %>
  <% end %>
<% end %>
