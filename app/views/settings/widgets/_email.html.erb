<%# Changing the address asks for the password too, so the row opens into a small form rather than
    carrying an input it could not submit on its own. %>
<%= turbo_frame_tag 'update_email_form', class: 'sitem' do %>
  <% hint = if current_user.pending_reconfirmation?
              t('devise.registrations.edit.awaiting_confirmation', email: current_user.unconfirmed_email)
            else
              current_user.email_was
            end %>
  <details <%= 'open' if current_user.errors.any? %>>
    <summary>
      <%= settings_row t('settings.index.email_section'), hint do %>
        <span class="rbutton rbutton--secondary"><%= t('settings.sections.change') %></span>
      <% end %>
    </summary>
    <%= form_with model: current_user, url: settings_update_email_path, class: 'sform sform--stack', data: { turbo_frame: 'update_email_form' } do |f| %>
      <%= f.email_field :email, value: '', autocomplete: 'username', required: true, class: 'rinput rinput--outline rinput--text',
                                pattern: User::Email::ADDRESS_PATTERN, placeholder: t('helpers.label.user.new_email'),
                                aria: { label: t('helpers.label.user.new_email') } %>
      <%= f.password_field :current_password, autocomplete: 'current-password', required: true, class: 'rinput rinput--outline rinput--text',
                                              placeholder: t('helpers.label.user.current_password'),
                                              aria: { label: t('helpers.label.user.current_password') } %>
      <%= f.submit t('button.save'), class: 'rbutton rbutton--secondary' %>
    <% end %>
  </details>
<% end %>
