<%= turbo_frame_tag 'update_password_form', class: 'sitem' do %>
  <details <%= 'open' if current_user.errors.any? %>>
    <summary>
      <%= settings_row t('settings.index.password_section') do %>
        <span class="rbutton rbutton--secondary"><%= t('settings.sections.change') %></span>
      <% end %>
    </summary>
    <%= form_with model: current_user, url: settings_update_password_path, class: 'sform sform--stack', data: {
      controller: 'form--password-strength form--password-match',
      turbo_frame: 'update_password_form',
      form__password_match_success_class_value: 'form__validation--success',
      form__password_strength_success_class_value: 'form__validation--success',
      form__password_strength_length_pattern_value: User::Password::LENGTH_PATTERN,
      form__password_strength_uppercase_pattern_value: User::Password::UPPERCASE_PATTERN,
      form__password_strength_lowercase_pattern_value: User::Password::LOWERCASE_PATTERN,
      form__password_strength_digit_pattern_value: User::Password::DIGIT_PATTERN,
      form__password_strength_symbol_pattern_value: User::Password::SYMBOL_PATTERN
    } do |f| %>
      <%# For password managers: the account the new password belongs to. %>
      <%= f.email_field :email, autocomplete: 'username', id: 'email_for_password_update', readonly: true, hidden: true %>
      <%= f.password_field :current_password, autocomplete: 'current-password', id: 'current_password_for_password_update',
                                              required: true, class: 'rinput rinput--outline rinput--text',
                                              placeholder: t('helpers.label.user.current_password'),
                                              aria: { label: t('helpers.label.user.current_password') } %>
      <%= f.password_field :password, autocomplete: 'new-password', required: true, class: 'rinput rinput--outline rinput--text',
                                      pattern: User::Password::PATTERN, placeholder: t('helpers.label.user.new_password'),
                                      aria: { label: t('helpers.label.user.new_password') }, data: {
                                        form__password_strength_target: 'input',
                                        form__password_match_target: 'input0',
                                        action: 'input->form--password-strength#checkPasswordStrength'
                                      } %>
      <%= f.password_field :password_confirmation, autocomplete: 'new-password', required: true, class: 'rinput rinput--outline rinput--text',
                                                   placeholder: t('helpers.label.user.new_password_confirmation'),
                                                   aria: { label: t('helpers.label.user.new_password_confirmation') }, data: {
                                                     form__password_match_target: 'input1',
                                                     action: 'input->form--password-match#checkPasswordMatch'
                                                   } %>
      <div data-form--password-strength-target="requirementsList" class="hidden">
        <ul class="password-requirements">
          <li class="form__validation" data-form--password-strength-target="length"><%= t('devise.passwords.validations.length', count: Devise.password_length.min) %></li>
          <li class="form__validation" data-form--password-strength-target="uppercase"><%= t('devise.passwords.validations.uppercase') %></li>
          <li class="form__validation" data-form--password-strength-target="lowercase"><%= t('devise.passwords.validations.lowercase') %></li>
          <li class="form__validation" data-form--password-strength-target="digit"><%= t('devise.passwords.validations.digit') %></li>
          <li class="form__validation" data-form--password-strength-target="symbol"><%= t('devise.passwords.validations.symbol') %></li>
          <li class="form__validation" data-form--password-match-target="match"><%= t('devise.passwords.validations.match') %></li>
        </ul>
      </div>
      <%= f.submit t('button.save'), class: 'rbutton rbutton--secondary' %>
    <% end %>
  </details>
<% end %>
