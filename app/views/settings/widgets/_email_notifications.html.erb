<%# Platform-provided SMTP, when the container has it, is the only provider: nothing to switch,
    only a test to send. Otherwise one switch for custom SMTP. Switching it off keeps the stored
    credentials, so switching it back on sends them back as placeholders — the controller keeps
    what is stored — instead of asking for them again. %>
<%= turbo_frame_tag 'email_notifications', class: 'sitem' do %>
  <% env_available = AppConfig.smtp_env_available? %>
  <% configured = !env_available && AppConfig.smtp_provider == 'custom_smtp' %>
  <% show_form = @show_smtp_form || false %>
  <% has_credentials = AppConfig.smtp_username.present? && AppConfig.smtp_password.present? %>
  <% send_test = button_to t('settings.email_notifications.send_test'), settings_send_test_email_path,
                           class: 'rbutton rbutton--outline' %>

  <% if env_available %>
    <%= settings_row t('settings.index.email_notifications_section'), AppConfig.smtp_env_provider_name do %>
      <%= send_test %>
    <% end %>
  <% else %>
    <% hint = t('settings.email_notifications.smtp_configured_html', host: AppConfig.smtp_host.presence || 'smtp.gmail.com') if configured %>
    <%= settings_row t('settings.index.email_notifications_section'), hint do %>
      <% if configured %>
        <%= send_test %>
        <%= render 'settings/confirm', label: t('settings.email_notifications.disconnect'),
                                       text: t('settings.index.api_key_confirmation'),
                                       confirm: t('settings.email_notifications.disconnect'),
                                       url: settings_disconnect_email_path %>
      <% end %>
      <%= render 'settings/switch', url: settings_update_email_notifications_path, frame: 'email_notifications',
                                    name: :smtp_provider, state: (configured || show_form ? :on : :off),
                                    enabled: (configured || show_form ? '' : 'custom_smtp'),
                                    title: t('settings.index.email_notifications_section'),
                                    fields: (if has_credentials
                                               { smtp_username: SettingsController::REDACTED,
                                                 smtp_password: SettingsController::REDACTED,
                                                 smtp_host: AppConfig.smtp_host, smtp_port: AppConfig.smtp_port }
                                             else
                                               {}
                                             end) %>
    <% end %>

    <% if show_form && !configured %>
      <%= form_with url: settings_update_email_notifications_path, method: :patch, class: 'sform sform--stack sform--inset sitem',
                    data: { turbo_frame: 'email_notifications' } do %>
        <%= hidden_field_tag :smtp_provider, 'custom_smtp', id: nil %>
        <%= text_field_tag :smtp_host, 'smtp.gmail.com', class: 'rinput rinput--outline rinput--text', aria: { label: t('settings.email_notifications.smtp_host') },
                                                         placeholder: t('settings.email_notifications.smtp_host') %>
        <%= number_field_tag :smtp_port, 587, class: 'rinput rinput--outline rinput--text', aria: { label: t('settings.email_notifications.smtp_port') },
                                              placeholder: t('settings.email_notifications.smtp_port') %>
        <%= text_field_tag :smtp_username, nil, class: 'rinput rinput--outline rinput--text', autocomplete: 'off',
                                                aria: { label: t('settings.email_notifications.smtp_username') },
                                                placeholder: t('settings.email_notifications.smtp_username') %>
        <%= password_field_tag :smtp_password, nil, class: 'rinput rinput--outline rinput--text', autocomplete: 'off',
                                                    aria: { label: t('settings.email_notifications.smtp_password') },
                                                    placeholder: t('settings.email_notifications.smtp_password') %>
        <p class="srow__hint"><%= t('settings.email_notifications.smtp_hint_html') %></p>
        <%= submit_tag t('settings.email_notifications.set'), class: 'rbutton rbutton--outline' %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
