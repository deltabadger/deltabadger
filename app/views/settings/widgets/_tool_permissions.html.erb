<%# One surface's tools: a switch per group, a switch per tool under it. Both surfaces carry every
    tool; each section shows its own. %>
<%
  s = if surface == 'mcp'
        { groups: AppConfig::MCP_TOOL_GROUPS, permissions: current_user.mcp_tool_permissions,
          tool_url: settings_update_mcp_tool_permissions_path, group_url: settings_update_mcp_tool_group_permissions_path }
      else
        { groups: AppConfig::REST_TOOL_GROUPS, permissions: current_user.rest_tool_permissions,
          tool_url: settings_update_rest_tool_permissions_path, group_url: settings_update_rest_tool_group_permissions_path }
      end
%>
<%= turbo_frame_tag 'tool_permissions' do %>
  <h3 class="settings__heading"><%= t('settings.mcp.tools_title') %></h3>
  <p class="settings__intro"><%= t('settings.mcp.tools_description') %></p>

  <% s[:groups].each do |group, tools| %>
    <% on = tools.count { |tool| s[:permissions][tool] } %>
    <%= settings_row t("settings.mcp.tools_#{group}"), class: 'srow--group', data: { group: group, surface: surface } do %>
      <%= render 'settings/switch', url: s[:group_url], frame: 'tool_permissions', fields: { group: group },
                                    state: (on.zero? ? :off : (on == tools.size ? :on : :partial)),
                                    enabled: (on == tools.size ? '0' : '1') %>
    <% end %>
    <% tools.each do |tool| %>
      <%= settings_row t("settings.mcp.tools.#{tool}.label"), t("settings.mcp.tools.#{tool}.description"),
                       class: 'srow--tool', data: { tool: tool, surface: surface } do %>
        <%= render 'settings/switch', url: s[:tool_url], frame: 'tool_permissions', fields: { tool_name: tool },
                                      state: (s[:permissions][tool] ? :on : :off),
                                      enabled: (s[:permissions][tool] ? '0' : '1') %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
