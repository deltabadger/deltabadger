<%# The tool catalogue, once: a row per tool in MCP's grouping, a switch column per surface.
    REST offers fewer tools and files the two exports under Read, so its column has gaps — an
    empty cell where REST has no such tool, and no group switch on Tax, which REST has no group
    for. The REST Read switch therefore also reaches the two export rows down in Tax. %>
<%
  surfaces = {
    'mcp' => { groups: AppConfig::MCP_TOOL_GROUPS, tools: AppConfig::MCP_TOOL_DEFAULTS,
               permissions: current_user.mcp_tool_permissions,
               tool_url: settings_update_mcp_tool_permissions_path,
               group_url: settings_update_mcp_tool_group_permissions_path },
    'rest' => { groups: AppConfig::REST_TOOL_GROUPS, tools: AppConfig::REST_TOOL_DEFAULTS,
                permissions: current_user.rest_tool_permissions,
                tool_url: settings_update_rest_tool_permissions_path,
                group_url: settings_update_rest_tool_group_permissions_path }
  }
%>
<%= turbo_frame_tag 'tool_permissions' do %>
  <div class="widget widget--settings">
    <h4 class="modal__title"><%= t('settings.mcp.tools_title') %></h4>
    <p class="text-center" style="text-wrap: balance"><%= t('settings.mcp.tools_description') %></p>

    <table class="permissions">
      <thead>
        <tr>
          <th></th>
          <th class="permissions__surface">MCP</th>
          <th class="permissions__surface"><%= t('settings.rest.title') %></th>
        </tr>
      </thead>
      <% AppConfig::MCP_TOOL_GROUPS.each do |group, tools| %>
        <tbody>
          <tr class="permissions__group" data-group="<%= group %>">
            <th><%= t("settings.mcp.tools_#{group}") %></th>
            <% surfaces.each do |surface, s| %>
              <td class="permissions__cell" data-surface="<%= surface %>">
                <% if (own = s[:groups][group]) %>
                  <% on = own.count { |tool| s[:permissions][tool] } %>
                  <%= render 'settings/widgets/permission_switch',
                             url: s[:group_url], frame: 'tool_permissions', fields: { group: group },
                             state: (on.zero? ? :off : (on == own.size ? :on : :partial)),
                             enabled: (on == own.size ? '0' : '1') %>
                <% else %>
                  <span class="permissions__none">–</span>
                <% end %>
              </td>
            <% end %>
          </tr>
          <% tools.each do |tool| %>
            <tr class="permissions__tool" data-tool="<%= tool %>">
              <td>
                <span class="permissions__name"><%= t("settings.mcp.tools.#{tool}.label") %></span>
                <span class="permissions__desc"><%= t("settings.mcp.tools.#{tool}.description") %></span>
              </td>
              <% surfaces.each do |surface, s| %>
                <td class="permissions__cell" data-surface="<%= surface %>">
                  <% if s[:tools].key?(tool) %>
                    <%= render 'settings/widgets/permission_switch',
                               url: s[:tool_url], frame: 'tool_permissions', fields: { tool_name: tool },
                               state: (s[:permissions][tool] ? :on : :off),
                               enabled: (s[:permissions][tool] ? '0' : '1') %>
                  <% else %>
                    <span class="permissions__none">–</span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      <% end %>
    </table>
  </div>
<% end %>
