            }
          },
          "additionalProperties": true
        },
        "context": {
          "type": "object",
          "properties": {
            "arguments": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        },
        "ref": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "name",
                "type"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "const": "ref/prompt"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "object",
              "required": [
                "type",
                "uri"
              ],
              "properties": {
                "type": {
                  "const": "ref/resource"
                },
                "uri": {
                  "type": "string",
                  "format": "uri-template"
                }
              },
              "additionalProperties": true
            }
          ]
        }
      },
      "additionalProperties": true
    }
