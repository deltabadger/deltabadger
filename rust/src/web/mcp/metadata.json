  "tools": [
    {
      "name": "list_bots",
      "description": "List all DCA bots with their status, type, trading pair, and exchange",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Filter by status: scheduled, executing, waiting, retrying, stopped, created (optional)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_bot_details",
      "description": "Get detailed information about a specific bot including performance metrics (P/L, average price, invested, current value)",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_exchanges",
      "description": "List connected exchanges with API key status",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "get_exchange_balances",
      "description": "Fetch live balances from a connected exchange. Requires the exchange name (e.g., 'Binance', 'Kraken', 'Coinbase').",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "exchange_name": {
            "type": "string",
            "description": "Exchange name (e.g., Binance, Kraken, Coinbase)"
          }
        },
        "required": [
          "exchange_name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "get_portfolio_summary",
      "description": "Get a portfolio summary including global P/L, bot count breakdown, and per-bot P/L",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_transactions",
      "description": "List recent transactions (trades) with optional bot filter and limit",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "Filter by bot ID (optional)"
          },
          "limit": {
            "type": "number",
            "description": "Number of transactions to return (default: 20, max: 100)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "start_bot",
      "description": "Start a stopped or newly created DCA bot",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "stop_bot",
      "description": "Stop a running DCA bot",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "update_bot_settings",
      "description": "Update settings on a stopped or newly created bot: amount and label on any bot, the index knobs on an index bot, the weights on a basket bot",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          },
          "quote_amount": {
            "type": "number",
            "description": "Amount per order in quote currency (optional)"
          },
          "label": {
            "type": "string",
            "description": "Bot label (optional)"
          },
          "num_coins": {
            "type": "number",
            "description": "Index bots: how many top assets to hold (2-100)"
          },
          "allocation_flattening": {
            "type": "number",
            "description": "Index bots: 0 = market-cap weights, 1 = equal"
          },
          "allocations": {
            "type": "string",
            "description": "Basket bots: new weights for every current asset, e.g. 'BTC:70,ETH:30' (sum 100). Name an asset by its key from get_bot_details when two share a symbol, or by asset id"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "list_open_orders",
      "description": "List currently open (unfilled) orders across all connected exchanges",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "exchange_name": {
            "type": "string",
            "description": "Filter by exchange name (optional)"
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "list_tax_jurisdictions",
      "description": "List all supported tax jurisdictions with their calculation method and currency",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {},
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true
      }
    },
    {
      "name": "delete_bot",
      "description": "Delete a bot (running or not). Its schedule is cancelled; its history is kept but hidden.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "archive_bot",
      "description": "Archive a bot: it stops, leaves the dashboard, keeps its history. Reactivate with unarchive_bot.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "name": "unarchive_bot",
      "description": "Bring an archived bot back, stopped.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "bot_id": {
            "type": "number",
            "description": "The bot ID"
          }
        },
        "required": [
          "bot_id"
        ],
        "additionalProperties": false
      }
    }
  ],
