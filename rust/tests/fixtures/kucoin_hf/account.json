    {
      "id": "detect_classic",
      "endpoint": "mode",
      "provenance": {
        "kind": "synthetic-variant",
        "sources": [
          "mode",
          "opened"
        ],
        "note": "Keep only selfAccountMode; vary CLASSIC/UNIFIED and the separately returned opened boolean.",
        "response_edits": [
          {
            "path": "/data/classicSubAccount",
            "remove": true
          },
          {
            "path": "/data/unifiedSubAccount",
            "remove": true
          }
        ]
      },
      "request": {
        "method": "GET",
        "path": "/api/ua/v2/account/mode",
        "query": []
      },
      "response": {
        "status": 200,
        "body": {
          "code": "200000",
          "data": {
            "selfAccountMode": "CLASSIC"
          }
        }
      },
      "expect": {
        "mode": "ClassicLf",
        "placement_posts": 0,
        "opened_requests": 1
      },
      "then": {
        "request": {
          "method": "GET",
          "path": "/api/v1/hf/accounts/opened",
          "query": []
        },
        "response": {
          "status": 200,
          "body": {
            "code": "200000",
            "data": false
          }
        }
      }
