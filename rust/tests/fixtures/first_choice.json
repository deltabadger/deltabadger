{
  "about": "D-LANGUAGE-STEP: which language a first start uses unasked (use) and which one the picker preselects when it asks (ask), given the user's languages in preference order. Read by rust/tests/language.rs and src-tauri/src/tests.rs.",
  "preferences": [
    { "languages": [], "choice": ["ask", "en"] },
    { "languages": ["en"], "choice": ["ask", "en"] },
    { "languages": ["en-GB"], "choice": ["ask", "en"] },
    { "languages": ["en-US"], "choice": ["ask", "en"] },
    { "languages": ["ja"], "choice": ["ask", "en"] },
    { "languages": ["ja-JP"], "choice": ["ask", "en"] },
    { "languages": ["ja", "pl"], "choice": ["ask", "pl"] },
    { "languages": ["ja-JP", "pl-PL"], "choice": ["ask", "pl"] },
    { "languages": ["en-US", "de-DE"], "choice": ["ask", "en"] },
    { "languages": ["pl"], "choice": ["use", "pl"] },
    { "languages": ["pl-PL"], "choice": ["use", "pl"] },
    { "languages": ["pl-PL", "en-US"], "choice": ["use", "pl"] },
    { "languages": ["de-CH", "de", "en"], "choice": ["use", "de"] },
    { "languages": ["EL-gr"], "choice": ["use", "el"] },
    { "languages": ["pt-BR"], "choice": ["use", "pt"] },
    { "languages": ["zh-Hans-CN", "fr-FR"], "choice": ["ask", "fr"] }
  ],
  "headers": [
    { "header": "", "choice": ["ask", "en"] },
    { "header": "en-US,en;q=0.9", "choice": ["ask", "en"] },
    { "header": "ja,pl;q=0.8", "choice": ["ask", "pl"] },
    { "header": "de-CH,de;q=0.9,en;q=0.8", "choice": ["use", "de"] },
    { "header": "pl", "choice": ["use", "pl"] },
    { "header": "ja,pl;q=0", "choice": ["ask", "en"] },
    { "header": "de;q=0", "choice": ["ask", "en"] },
    { "header": "de;q=0,pl", "choice": ["use", "pl"] },
    { "header": "en;q=0.5,fr", "choice": ["use", "fr"] },
    { "header": "*", "choice": ["ask", "en"] }
  ],
  "parse": [
    { "header": "", "languages": [] },
    { "header": "  ", "languages": [] },
    { "header": "de", "languages": ["de"] },
    { "header": "de-CH, de;q=0.9, en;q=0.8", "languages": ["de-CH", "de", "en"] },
    { "header": "en;q=0.5,fr,pl;q=0.7", "languages": ["fr", "pl", "en"] },
    { "header": "fr;q=0.8,de;q=0.8,pl;q=0.8", "languages": ["fr", "de", "pl"] },
    { "header": "fr,de,pl", "languages": ["fr", "de", "pl"] },
    { "header": "*,pl;q=0.5", "languages": ["pl"] },
    { "header": "ja,pl;q=0", "languages": ["ja"] },
    { "header": "pl;q=0.000,de;Q=0.001", "languages": ["de"] },
    { "header": "pl;q=1.0,de;q=1", "languages": ["pl", "de"] },
    { "header": "pl;q=1.5,de", "languages": ["de"] },
    { "header": "pl;q=abc,de", "languages": ["de"] },
    { "header": "pl;q=0.12345,de", "languages": ["de"] },
    { "header": "pl;q,de", "languages": ["de"] },
    { "header": "p_l,de", "languages": ["de"] },
    { "header": "toolongtag,de", "languages": ["de"] },
    { "header": "de-,pl", "languages": ["pl"] },
    { "header": ",,de,,", "languages": ["de"] },
    { "header": "zh-Hant-TW;q=0.9,en-GB", "languages": ["en-GB", "zh-Hant-TW"] }
  ]
}
