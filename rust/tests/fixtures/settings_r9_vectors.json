{
  "throttles": {
    "oauth/register": {
      "limit": 5,
      "period": 60
    },
    "oauth/token": {
      "limit": 20,
      "period": 60
    },
    "oauth/authorize": {
      "limit": 10,
      "period": 60
    },
    "users/login": {
      "limit": 10,
      "period": 60
    },
    "users/verify_two_factor": {
      "limit": 5,
      "period": 60
    },
    "users/password": {
      "limit": 5,
      "period": 60
    },
    "users/confirmation": {
      "limit": 5,
      "period": 60
    },
    "setup": {
      "limit": 5,
      "period": 60
    },
    "setup/token": {
      "limit": 5,
      "period": 60
    },
    "setup/platform_connection": {
      "limit": 5,
      "period": 60
    },
    "csp-report": {
      "limit": 30,
      "period": 60
    }
  },
  "sign_in_email": {
    "nbsp": {
      "submitted": " STRIP@Example.com ",
      "lookup_matches": false
    },
    "em_space": {
      "submitted": " STRIP@Example.com ",
      "lookup_matches": false
    },
    "nul": {
      "submitted": "\u0000STRIP@Example.com\u0000",
      "lookup_matches": true
    }
  },
  "redacted": "[redacted]",
  "sensitive_query": [
    "confirmation_token",
    "password",
    "password_confirmation",
    "current_password",
    "otp_secret_key",
    "otp_secret",
    "otp_code_token",
    "key",
    "secret",
    "passphrase",
    "access_token",
    "refresh_token",
    "rsa_signature_key",
    "rsa_encryption_key",
    "dh_param",
    "api_token",
    "smtp_username",
    "smtp_password",
    "coingecko_api_key",
    "alpaca_api_key",
    "alpaca_api_secret",
    "market_data_token",
    "reset_password_token",
    "unlock_token",
    "token",
    "claim_code",
    "code"
  ],
  "smtp_custom_requires_starttls": "always"
}
