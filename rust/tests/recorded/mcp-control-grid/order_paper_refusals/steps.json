      "INSERT INTO bots (id,type,user_id,exchange_id,status,label,settings,transient_data,started_at,created_at,updated_at) VALUES (3,'Bots::Signal',(SELECT id FROM users WHERE email='owner@example.com'),(SELECT id FROM exchanges WHERE name='Alpaca'),1,'Signal 3',json_object('base_asset_id',(SELECT id FROM assets WHERE symbol='QQQM'),'quote_asset_id',(SELECT id FROM assets WHERE symbol='USD')),'{}','2026-09-09 12:00:00','2026-01-01 00:00:00','2026-01-01 00:00:00')",
