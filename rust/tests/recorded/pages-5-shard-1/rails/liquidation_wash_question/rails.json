"\">\n            <span class=\"no-value\">—</span>\n        </td>\n        \n      </tr>\n  </tbody>\n</table>\n\n\n      </div>\n\n      <form data-controller=\"form--checkbox-enables\" data-action=\"turbo:submit-end-&gt;modal--base#submitEnd change-&gt;form--checkbox-enables#toggleSubmitButton\" action=\"/bots/1/liquidation?asset_id%5B%5D=4&amp;symbol%5B%5D=NVDA\" accept-charset=\"UTF-8\" method=\"post\"><input type=\"hidden\" name=\"authenticity_token\" value=\"tpEt8g3-X9qK5c9zxRr6Azgv8ceDsKg9OZOZpNQG2gvqoS3dwvbJ-oTDW4plL65g797TW3XUmKWgC1z6-7SGPw\" />\n        <div class=\"wash-sale-question\">\n  <p class=\"text-inactive\">The United States, the United Kingdom and Ireland disallow a loss if you buy the same asset back too soon. Pick the window for the country you pay tax in, or choose &quot;Don&#39;t apply this rule&quot;.</p>\n\n  <label class=\"form__radio\">\n    <input type=\"radio\" name=\"wash_sale[enabled]\" id=\"wash_sale_enabled_1\" value=\"1\" data-form--checkbox-enables-target=\"checkbox\" />\n    <span class=\"conversational conversational--small\">\n      Avoid wash sales by waiting         <div class=\"sinput sinput--select\" data-controller=\"form--select-display\">\n          <span data-form--select-display-target=\"label\">30 days (US)</span>\n          <select name=\"wash_sale[jurisdiction]\" id=\"wash_sale_jurisdiction\" data-action=\"change-&gt;form--select-display#update\"><option selected=\"selected\" value=\"US\">30 days (US)</option>\n<option value=\"GB\">30 days (UK)</option>\n<option value=\"IE\">28 days (IE)</option></select>\n        </div>\n after selling at a loss\n    </span>\n  </label>\n\n  <label class=\"form__radio\">\n    <input type=\"radio\" name=\"wash_sale[enabled]\" id=\"wash_sale_enabled_0\" value=\"0\" data-form--checkbox-enables-target=\"checkbox\" />\n    <span class=\"conversational conversational--small\">Don&#39;t apply this rule</span>\n  </label>\n</div>\n\n\n        <div class=\"modal__footer\">\n          <button name=\"button\" type=\"button\" class=\"rbutton rbutton--secondary\" data-action=\"modal--base#animateOutCloseAndCleanUp\">\n            Cancel\n</button>          <button name=\"button\" type=\"submit\" disabled=\"disabled\" data-form--checkbox-enables-target=\"submit\" data-turbo-submits-with=\"Selling…\" class=\"rbutton rbutton--danger\">Sell</button>\n        </div>\n</form>    </div>\n  </div>\n\n    </div>\n  </dialog>\n</turbo-frame>\n  </body>\n</html>\n",
